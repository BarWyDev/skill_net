{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skillnet",
  // A custom entry: the adapter's fetch handler plus the queue consumer for SMS alerts (S-07).
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Production answers on skillnet.org.pl and www. The owner attached both custom domains in the
  // dashboard before this landed, so a deploy only confirms them. Previews still use workers.dev.
  "routes": [
    { "pattern": "skillnet.org.pl", "custom_domain": true },
    { "pattern": "www.skillnet.org.pl", "custom_domain": true },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "ac680c0499b04685bdd941b6d25b6b77",
    },
  ],
  // Auth form throttle (security audit F-09, src/lib/auth-throttle.ts). Counted per Cloudflare
  // location. The namespace ids are this account's own; don't reuse them for another limiter.
  // Previews inherit no bindings, so the throttle is off there (it fails open).
  "ratelimits": [
    {
      "name": "AUTH_IP_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "AUTH_ACCOUNT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // SMS alerts (S-07). The coordinator's request puts alert ids on the queue; the consumer in
  // src/worker.ts sends each one, retries three times, then hands it to the dead-letter queue, whose
  // consumer marks the alert as failed. Queues need the Workers Paid plan, and both queues must exist
  // before a deploy (`npx wrangler queues create <name>`), or the deploy fails. Previews get no queue
  // binding: there the app sends through the fake provider in the request instead.
  "queues": {
    "producers": [{ "binding": "SMS_ALERTS", "queue": "skillnet-sms-alerts" }],
    "consumers": [
      {
        "queue": "skillnet-sms-alerts",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "dead_letter_queue": "skillnet-sms-alerts-dlq",
      },
      { "queue": "skillnet-sms-alerts-dlq", "max_batch_size": 10, "max_batch_timeout": 5 },
    ],
  },
  // Previews don't inherit bindings, and the adapter would inject an ID-less SESSION here (error 10021).
  // A separate namespace keeps previews from writing to production KV.
  "previews": {
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "95e132ccfd4f47baac88a246023277bf",
      },
    ],
  },
  // Stable staging (change staging-environment): a second Worker at staging.skillnet.org.pl, behind
  // Cloudflare Access, on the staging Supabase project. `npm run build:staging` (CLOUDFLARE_ENV=staging)
  // flattens this block into dist/server/wrangler.json, so the deploy needs no --env. Bindings are not
  // inherited: staging has its own KV and its own limiter namespaces, so a burst on staging can't
  // throttle production sign-ins. `assets` and `observability` are inherited.
  "env": {
    "staging": {
      "name": "skillnet-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.skillnet.org.pl", "custom_domain": true }],
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "164402d7b284455095617f8b171a8853",
        },
      ],
      "ratelimits": [
        {
          "name": "AUTH_IP_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "AUTH_ACCOUNT_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      // Staging has its own pair of queues, so a test send on staging never lands in production's.
      "queues": {
        "producers": [{ "binding": "SMS_ALERTS", "queue": "skillnet-sms-alerts-staging" }],
        "consumers": [
          {
            "queue": "skillnet-sms-alerts-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 2,
            "max_retries": 3,
            "dead_letter_queue": "skillnet-sms-alerts-staging-dlq",
          },
          { "queue": "skillnet-sms-alerts-staging-dlq", "max_batch_size": 10, "max_batch_timeout": 5 },
        ],
      },
    },
  },
}
