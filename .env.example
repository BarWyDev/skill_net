# Copy to .env (astro dev/build) and .dev.vars (Cloudflare workerd runtime).
# Local values come from `npx supabase start` (API URL and the publishable/anon key).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<publishable-or-anon-key>
# The interface languages on offer. Unset means Polish only (what production runs until S-19).
# In .dev.vars this overrides the "pl" that wrangler.jsonc sets for production.
ENABLED_LOCALES=pl,en,uk
