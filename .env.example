# Copy to .env (astro dev/build) and .dev.vars (Cloudflare workerd runtime).
# Local values come from `npx supabase start` (API URL and the publishable/anon key).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<publishable-or-anon-key>

# SMS alerts (S-07). Leave these out locally: without SMSAPI_TOKEN the app uses the fake provider
# and never sends a real SMS. Production and staging get them from `npx wrangler secret put`.
# SMSAPI_TOKEN=
# SMS_WEBHOOK_SECRET=
# SMS_WORKER_TOKEN=
# SMS_PROVIDER=fake
# SMSAPI_SENDER=
