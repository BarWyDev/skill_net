---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { EMAIL_STORAGE_KEY } from "@/components/auth/SignInForm";
import { SIGNUP_EMAIL_STORAGE_KEY } from "@/components/auth/SignUpForm";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SkillNet",
  description = "Lokalny katalog umiejętności na czas kryzysu i na co dzień: sąsiedzi, którzy mogą pomóc w okolicy.",
} = Astro.props;
const ogImage = new URL("/og-image.png", Astro.site).href;
const OG_IMAGE_ALT = "SkillNet: lokalny katalog umiejętności na czas kryzysu. Ciemne tło i siatka kwadratów mapy.";
// Each auth form reads (and then removes) its saved address itself; every other page drops it.
const staleEmailKeys = [
  [EMAIL_STORAGE_KEY, "/auth/signin"],
  [SIGNUP_EMAIL_STORAGE_KEY, "/auth/signup"],
]
  .filter(([, page]) => Astro.url.pathname !== page)
  .map(([key]) => key);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Icons and the share image come from scripts/generate-brand-assets.mjs. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1e2024" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SkillNet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    <script is:inline define:vars={{ keys: staleEmailKeys }}>
      try {
        keys.forEach((key) => sessionStorage.removeItem(key));
      } catch {}
    </script>
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
    <!-- Every page links the data-processing notice (QA-002), on the content's left edge. -->
    <footer class="bg-graphite font-body text-ash pb-6 text-sm">
      <div class="mx-auto max-w-6xl px-4 sm:px-8">
        <a
          href="/prywatnosc"
          class="hover:text-chalk focus-visible:outline-signal inline-flex min-h-11 items-center underline underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-3"
        >
          Prywatność i przetwarzanie danych
        </a>
      </div>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
