---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { EMAIL_STORAGE_KEY } from "@/components/auth/SignInForm";
import { SIGNUP_EMAIL_STORAGE_KEY } from "@/components/auth/SignUpForm";

interface Props {
  title?: string;
  description?: string;
  /** "graphite" matches the landing page; every other page keeps the dark footer. */
  footer?: "graphite" | "dark";
}

const {
  title = "SkillNet",
  description = "Lokalny katalog umiejętności na czas kryzysu i na co dzień: sąsiedzi, którzy mogą pomóc w okolicy.",
  footer = "dark",
} = Astro.props;
// Each auth form reads (and then removes) its saved address itself; every other page drops it.
const staleEmailKeys = [
  [EMAIL_STORAGE_KEY, "/auth/signin"],
  [SIGNUP_EMAIL_STORAGE_KEY, "/auth/signup"],
]
  .filter(([, page]) => Astro.url.pathname !== page)
  .map(([key]) => key);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SkillNet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline define:vars={{ keys: staleEmailKeys }}>
      try {
        keys.forEach((key) => sessionStorage.removeItem(key));
      } catch {}
    </script>
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
    <!-- Every page links the data-processing notice (QA-002). The dark colour continues bg-cosmic. -->
    <footer
      class:list={[
        "pb-6 text-sm",
        footer === "dark" && "bg-[#0a0e1a] px-4 text-center text-blue-100/60",
        footer === "graphite" && "bg-[#1e2024] font-['Atkinson_Hyperlegible_Next',sans-serif] text-[#a3a6ad]",
      ]}
    >
      <div class:list={[footer === "graphite" && "mx-auto max-w-6xl px-4 sm:px-8"]}>
        <a
          href="/prywatnosc"
          class:list={[
            "inline-flex min-h-11 items-center",
            footer === "dark" && "text-purple-300 transition-colors hover:text-purple-100 hover:underline",
            footer === "graphite" &&
              "underline underline-offset-4 hover:text-[#ece9e2] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[#f2c230]",
          ]}
        >
          Prywatność i przetwarzanie danych
        </a>
      </div>
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
