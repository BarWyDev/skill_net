---
import PageShell from "@/components/PageShell.astro";
import { TEXT_LINK } from "@/lib/site-styles";
import { cn } from "@/lib/utils";

// Rendered in place by the middleware for signed-in users without the coordinator role.
Astro.response.status = 403;
const { user } = Astro.locals;
---

<PageShell title="Brak dostępu — SkillNet" heading="Brak dostępu">
  <p class="max-w-[52ch] text-lg leading-relaxed">
    Ta część serwisu jest dostępna tylko dla koordynatorów wyznaczonych przez operatora.
  </p>
  <a href={user ? "/profil" : "/"} class:list={cn(TEXT_LINK, "mt-6")}>
    {user ? "Wróć do profilu" : "Wróć na stronę główną"}
  </a>
</PageShell>
