---
import PageShell from "@/components/PageShell.astro";
import { TEXT_LINK } from "@/lib/site-styles";
import { cn } from "@/lib/utils";
import { errors } from "@/lib/i18n/messages/errors";

// Rendered in place by the middleware for signed-in users without the coordinator role.
Astro.response.status = 403;
const { user, locale } = Astro.locals;
const t = errors[locale].accessDenied;
---

<PageShell title={t.title} heading={t.heading}>
  <p class="max-w-[52ch] text-lg leading-relaxed">{t.body}</p>
  <a href={user ? "/profil" : "/"} class:list={cn(TEXT_LINK, "mt-6")}>
    {user ? t.backToProfile : t.backHome}
  </a>
</PageShell>
