---
import PageShell from "@/components/PageShell.astro";
import { TEXT_LINK } from "@/lib/site-styles";
import { errors } from "@/lib/i18n/messages/errors";

Astro.response.status = 404;
const t = errors[Astro.locals.locale].notFound;
---

<PageShell title={t.title} heading={t.heading}>
  <p class="max-w-[52ch] text-lg leading-relaxed">{t.body}</p>
  <div class="mt-6 flex flex-wrap gap-x-6">
    <a href="/" class:list={TEXT_LINK}>
      {t.home}
    </a>
    <a href="/mapa" class:list={TEXT_LINK}>
      {t.map}
    </a>
  </div>
</PageShell>
