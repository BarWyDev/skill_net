---
import PageShell from "@/components/PageShell.astro";
import { TEXT_LINK } from "@/lib/site-styles";

Astro.response.status = 404;
---

<PageShell title="Nie znaleziono strony — SkillNet" heading="Nie znaleziono strony">
  <p class="max-w-[52ch] text-lg leading-relaxed">
    Pod tym adresem nic nie ma. Link mógł się zmienić albo zawierać literówkę.
  </p>
  <div class="mt-6 flex flex-wrap gap-x-6">
    <a href="/" class:list={TEXT_LINK}>
      Strona główna
    </a>
    <a href="/mapa" class:list={TEXT_LINK}>
      Mapa umiejętności
    </a>
  </div>
</PageShell>
