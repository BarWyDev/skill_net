---
import Landing from "@/components/Landing.astro";
import Layout from "@/layouts/Layout.astro";
import StatusLine from "@/components/StatusLine.astro";

const accountDeleted = Astro.url.searchParams.has("konto-usuniete");
---

<Layout>
  <Landing>
    {accountDeleted && (
      <StatusLine tone="done" role="status" class="mt-6 font-bold">
        Twoje konto i dane zostały usunięte.
      </StatusLine>
    )}
  </Landing>
</Layout>
