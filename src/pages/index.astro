---
import Landing from "@/components/Landing.astro";
import Layout from "@/layouts/Layout.astro";

const accountDeleted = Astro.url.searchParams.has("konto-usuniete");
---

<Layout footer="graphite">
  <Landing>
    {accountDeleted && (
      <p role="status" class="border-seam mt-6 border max-w-2xl px-4 py-3">
        Twoje konto i dane zostały usunięte.
      </p>
    )}
  </Landing>
</Layout>
