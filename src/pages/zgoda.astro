---
import AuthShell from "@/components/auth/AuthShell.astro";
import StatusLine from "@/components/StatusLine.astro";
import DeleteAccount from "@/components/profile/DeleteAccount.astro";
import { CONSENT_LABEL, CONSENT_LINK_TEXT } from "@/lib/consent";
import { BUTTON, TEXT_LINK } from "@/lib/site-styles";
import { cn } from "@/lib/utils";

// The consent gate (roadmap S-05). The middleware sends every signed-in user whose latest consent is
// not the current version here, redirects anonymous visitors to sign-in, and sends users who are not
// gated home, so this page only renders for someone who has something to accept.

Astro.response.headers.set("Cache-Control", "private, no-store");

const error = Astro.url.searchParams.get("error");
---

<AuthShell title="Zgoda na przetwarzanie danych — SkillNet" heading="Potrzebujemy Twojej zgody">
  {error && (
    <StatusLine tone="error" role="alert" class="mb-8 font-bold">
      {error}
    </StatusLine>
  )}

  <p class="leading-relaxed">
    Aby dalej korzystać z SkillNet, potwierdź zgodę na przetwarzanie danych. Bez niej nie uwzględniamy Cię w kryzysach
    ani na mapie. Możesz też wylogować się albo usunąć konto.
  </p>

  <form method="post" action="/api/zgoda" class="mt-8">
    <label for="consent" class="flex min-h-11 cursor-pointer items-start gap-4 py-2.5 text-[0.9375rem] leading-relaxed">
      <input id="consent" name="consent" type="checkbox" required class="check mt-0.5" />
      <span>
        {CONSENT_LABEL}{" "}
        <a href="/prywatnosc" target="_blank" rel="noopener" class="text-chalk font-bold underline underline-offset-4">
          {CONSENT_LINK_TEXT}
        </a>
      </span>
    </label>
    <button type="submit" class:list={cn(BUTTON, "btn-primary mt-6 w-full cursor-pointer sm:w-auto")}>
      Akceptuję i przechodzę dalej
    </button>
  </form>

  <form method="post" action="/api/auth/signout" class="mt-6">
    <button type="submit" class:list={cn(TEXT_LINK, "cursor-pointer")}>
      Wyloguj się
    </button>
  </form>

  <DeleteAccount returnTo="/zgoda" />
</AuthShell>
