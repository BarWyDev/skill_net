---
import PageShell from "@/components/PageShell.astro";
import StatusLine from "@/components/StatusLine.astro";
import PrivacyNotice from "@/components/legal/PrivacyNotice.astro";
import { CURRENT_CONSENT_VERSION } from "@/lib/consent";
import { format, formatDate } from "@/lib/i18n/format";
import { legal } from "@/lib/i18n/messages/legal";
import { NAV_LINK } from "@/lib/site-styles";
import { cn } from "@/lib/utils";

// Public page (GDPR Art. 13 information notice). It renders per user (SiteHeader), so it is never
// cached as `public`.
// DRAFT: written by the implementer; the owner reviews the wording, and fills in the controller,
// before a real pilot. A wording change needs a new consent version (see src/lib/consent.ts).
// The Polish text is the binding one; English and Ukrainian are courtesy translations and show the
// Polish original below them (src/lib/i18n/messages/legal.ts).
Astro.response.headers.set("Cache-Control", "private");

const { locale } = Astro.locals;
const t = legal[locale];
const translated = locale !== "pl";
---

<PageShell title={t.privacy.title} description={t.privacy.description} heading={t.privacy.heading}>
  <p class="text-ash">{format(t.privacy.version, { date: formatDate(locale, CURRENT_CONSENT_VERSION) })}</p>

  <StatusLine tone="attention" role="note" class="mt-6">
    {t.privacy.draft}
  </StatusLine>
  {translated && (
    <StatusLine tone="attention" role="note" class="mt-3">
      {t.courtesy.note}
    </StatusLine>
  )}

  <PrivacyNotice notice={t.privacy} />

  {translated && (
    <details class="border-seam mt-16 border-t pt-8">
      <summary class:list={cn(NAV_LINK, "text-chalk cursor-pointer font-bold underline")}>
        {t.courtesy.original}
      </summary>
      <div lang="pl">
        <PrivacyNotice notice={legal.pl.privacy} />
      </div>
    </details>
  )}
</PageShell>

<style>
  /* No marker triangle: the summary reads as a link. */
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
</style>
