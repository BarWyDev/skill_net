---
import PageShell from "@/components/PageShell.astro";
import StatusLine from "@/components/StatusLine.astro";
import DeleteAccount from "@/components/profile/DeleteAccount.astro";
import NumberReveals from "@/components/profile/NumberReveals.astro";
import PauseAvailability from "@/components/profile/PauseAvailability.astro";
import ProfileForm from "@/components/profile/ProfileForm";
import { format, formatDate } from "@/lib/i18n/format";
import { auth } from "@/lib/i18n/messages/auth";
import { profile as profileMessages } from "@/lib/i18n/messages/profile";
import { categoryName, skillName } from "@/lib/i18n/messages/taxonomy";
import { createClient } from "@/lib/supabase";
import { getMyNumberReveals, getMyProfile, getTaxonomy } from "@/lib/services/profile";
import { BUTTON } from "@/lib/site-styles";
import { cn } from "@/lib/utils";
import type { MyProfileDTO, NumberRevealDTO, TaxonomyDTO } from "@/types";
import { takeFlashError } from "@/lib/flash";

const { locale } = Astro.locals;
const t = profileMessages[locale];

const SUCCESS_MESSAGES: [param: string, message: string][] = [
  ["zapisano", t.notices.saved],
  ["wstrzymano", t.notices.paused],
  ["wznowiono", t.notices.resumed],
];
const success = SUCCESS_MESSAGES.find(([param]) => Astro.url.searchParams.has(param))?.[1] ?? null;
// Left by the endpoint that redirected here; never read from the URL (security audit F-06).
const error = takeFlashError(Astro);

let taxonomy: TaxonomyDTO | null = null;
let profile: MyProfileDTO | null = null;
// Null when the lookup fails: the section then says so instead of claiming no one saw the number.
let reveals: NumberRevealDTO[] | null = null;
let loadError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = auth[locale].notConfigured;
} else {
  try {
    const [names, mine] = await Promise.all([getTaxonomy(supabase), getMyProfile(supabase)]);
    // The database holds Polish names; the form shows them in the request's language.
    taxonomy = {
      categories: names.categories.map((c) => ({ ...c, name: categoryName(locale, c.slug, c.name) })),
      skills: names.skills.map((s) => ({ ...s, name: skillName(locale, s.slug, s.name) })),
    };
    profile = mine;
  } catch {
    loadError = t.page.loadFailed;
  }
  reveals = await getMyNumberReveals(supabase).catch(() => null);
}
---

<!-- PageShell's 42rem column keeps every line under 80 characters. -->
<PageShell title={t.page.title} heading={t.page.heading}>
  {profile && (
    <div class="space-y-3 text-lg">
      {profile.paused ? (
        <StatusLine tone="attention">
          <p class="font-bold">
            {profile.pausedUntil
              ? format(t.status.pausedUntil, { date: formatDate(locale, profile.pausedUntil) })
              : t.status.pausedIndefinitely}
          </p>
          <p class="text-ash mt-1 text-base">{t.status.pausedEffect}</p>
          <form method="post" action="/api/profile/resume" class="mt-4">
            <button type="submit" class:list={cn(BUTTON, "btn-secondary text-chalk cursor-pointer")}>
              {t.status.resume}
            </button>
          </form>
        </StatusLine>
      ) : profile.complete && !profile.matchable ? (
        <StatusLine tone="attention">
          <p class="font-bold">{t.status.noCrisisSkills}</p>
          <p class="text-ash mt-1 text-base">{t.status.noCrisisSkillsHint}</p>
        </StatusLine>
      ) : profile.complete ? (
        <StatusLine tone="done">
          <p class="font-bold">{t.status.complete}</p>
        </StatusLine>
      ) : (
        <StatusLine tone="attention">
          <p>
            <strong>{t.status.incompleteLead}</strong> {t.status.incompleteBody}
          </p>
        </StatusLine>
      )}
      {profile.phone === null && (
        <StatusLine tone="attention">
          <p>{t.status.noPhone}</p>
        </StatusLine>
      )}
    </div>
  )}

  {success && !error && (
    <StatusLine tone="done" data-page-notice role="status" class="mt-6 font-bold">
      {success}
    </StatusLine>
  )}
  {error && (
    <StatusLine tone="error" data-page-notice role="alert" class="mt-6 font-bold">
      {error}
    </StatusLine>
  )}
  {(success !== null || error !== null) && <script is:inline>
    // The notice is for this page load only: a refresh must not show it again (QA-017, QA-019).
    history.replaceState(history.state, "", location.pathname);
  </script>}

  {loadError && (
    <StatusLine tone="error" role="alert" class="mt-6 font-bold">
      {loadError}
    </StatusLine>
  )}

  {taxonomy && profile && (
    <ProfileForm client:only="react" locale={locale} taxonomy={taxonomy} profile={profile}>
      <p slot="fallback" class="text-ash mt-14">
        {t.page.formLoading}
      </p>
    </ProfileForm>
  )}

  {profile?.complete && <PauseAvailability paused={profile.paused} pausedUntil={profile.pausedUntil} />}
  {profile && !profile.complete && (
    <p class="border-seam text-ash mt-16 border-t pt-10 leading-relaxed">{t.page.pauseNeedsComplete}</p>
  )}

  {profile && <NumberReveals reveals={reveals} />}

  {Astro.locals.user && <DeleteAccount />}
</PageShell>
