---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import DeleteAccount from "@/components/profile/DeleteAccount.astro";
import PauseAvailability from "@/components/profile/PauseAvailability.astro";
import ProfileForm from "@/components/profile/ProfileForm";
import { formatPauseUntil } from "@/lib/pause";
import { createClient } from "@/lib/supabase";
import { getMyProfile, getTaxonomy } from "@/lib/services/profile";
import type { MyProfileDTO, TaxonomyDTO } from "@/types";

const SUCCESS_MESSAGES: [param: string, message: string][] = [
  ["zapisano", "Zapisano."],
  ["wstrzymano", "Dostępność wstrzymana."],
  ["wznowiono", "Dostępność wznowiona."],
];
const success = SUCCESS_MESSAGES.find(([param]) => Astro.url.searchParams.has(param))?.[1] ?? null;
const error = Astro.url.searchParams.get("error");

let taxonomy: TaxonomyDTO | null = null;
let profile: MyProfileDTO | null = null;
let loadError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = "Supabase nie jest skonfigurowany.";
} else {
  try {
    [taxonomy, profile] = await Promise.all([getTaxonomy(supabase), getMyProfile(supabase)]);
  } catch {
    loadError = "Nie udało się wczytać profilu. Odśwież stronę.";
  }
}
---

<Layout title="Mój profil">
  <div class="bg-cosmic min-h-screen w-full">
    <div class="mx-auto max-w-2xl p-4 sm:p-8">
      <Topbar />

      <main class="rounded-2xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl sm:p-6">
        <h1 class="mb-4 text-2xl font-bold">Mój profil</h1>

        {success && !error && (
          <p
            data-page-notice
            role="status"
            class="mb-4 rounded-lg border border-green-400/50 bg-green-500/15 p-3 text-sm text-green-100"
          >
            {success}
          </p>
        )}
        {error && (
          <p
            data-page-notice
            role="alert"
            class="mb-4 rounded-lg border border-red-400/50 bg-red-500/15 p-3 text-sm text-red-100"
          >
            {error}
          </p>
        )}
        {(success !== null || error !== null) && <script is:inline>
          // The notice is for this page load only: a refresh must not show it again (QA-017, QA-019).
          history.replaceState(history.state, "", location.pathname);
        </script>}

        {profile?.paused && (
          <div class="mb-6 rounded-lg border border-amber-400/50 bg-amber-500/15 p-3 text-sm text-amber-100">
            <p class="font-medium">
              {profile.pausedUntil
                ? `Twoja dostępność jest wstrzymana do ${formatPauseUntil(profile.pausedUntil)} włącznie.`
                : "Twoja dostępność jest wstrzymana bezterminowo."}
            </p>
            <p class="mt-1 text-amber-100/80">
              Nie pojawisz się w nowych kryzysach ani na mapie, a w trwających kryzysach koordynator Cię nie widzi.
            </p>
            <form method="post" action="/api/profile/resume" class="mt-3">
              <button
                type="submit"
                class="h-12 w-full rounded-lg border border-amber-300/60 bg-amber-500/30 px-6 text-sm font-medium text-white transition-colors hover:bg-amber-500/40 sm:w-auto"
              >
                Wznów dostępność
              </button>
            </form>
          </div>
        )}
        {profile && !profile.paused && (
          <p
            class:list={[
              "mb-6 rounded-lg border p-3 text-sm",
              profile.complete
                ? "border-green-400/40 bg-green-500/10 text-green-100"
                : "border-amber-400/40 bg-amber-500/10 text-amber-100",
            ]}
          >
            {profile.complete
              ? "Profil kompletny"
              : "Profil niekompletny — dodaj lokalizację i co najmniej jedną umiejętność, aby koordynator mógł Cię znaleźć."}
          </p>
        )}
        {profile?.phone === null && (
          <p class="-mt-4 mb-6 rounded-lg border border-amber-400/30 bg-amber-500/5 p-3 text-sm text-amber-100/90">
            Bez numeru telefonu nie otrzymasz alertów kryzysowych.
          </p>
        )}

        {loadError && (
          <p role="alert" class="text-red-200">
            {loadError}
          </p>
        )}

        {taxonomy && profile && (
          <ProfileForm client:only="react" taxonomy={taxonomy} profile={profile}>
            <p slot="fallback" class="text-blue-100/70">
              Ładowanie formularza…
            </p>
          </ProfileForm>
        )}

        {profile?.complete && <PauseAvailability paused={profile.paused} pausedUntil={profile.pausedUntil} />}
        {profile && !profile.complete && (
          <p class="mt-10 text-sm text-blue-100/70">
            Wstrzymać dostępność możesz, gdy profil jest kompletny: ma lokalizację i co najmniej jedną umiejętność.
          </p>
        )}

        {Astro.locals.user && <DeleteAccount />}
      </main>
    </div>
  </div>
</Layout>
