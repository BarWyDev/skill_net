---
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { DensityMap } from "@/components/map/DensityMap";
import { createClient } from "@/lib/supabase";
import { getMyProfile, getTaxonomy } from "@/lib/services/profile";
import type { SkillCategoryDTO } from "@/types";
import { cn } from "@/lib/utils";
import { PAGE_TITLE } from "@/lib/site-styles";

// Public page. It renders per user (header, start point), so it is never cached as `public`.
Astro.response.headers.set("Cache-Control", "private");

let categories: SkillCategoryDTO[] | null = null;
let start: { lat: number; lng: number } | null = null;
let loadError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = "Mapa jest niedostępna, bo Supabase nie jest skonfigurowany.";
} else {
  try {
    categories = (await getTaxonomy(supabase)).categories;
  } catch {
    loadError = "Nie udało się wczytać mapy. Odśwież stronę.";
  }
  if (Astro.locals.user) {
    try {
      const profile = await getMyProfile(supabase);
      if (profile.lat !== null && profile.lng !== null) start = { lat: profile.lat, lng: profile.lng };
    } catch {
      // Without the resident's own point the map simply opens on Poland.
    }
  }
}
---

<Layout title="Mapa umiejętności — SkillNet">
  <div class="site min-h-screen">
    <div class="mx-auto max-w-6xl px-4 sm:px-8">
      <SiteHeader />
    </div>

    <main class="pb-16 sm:pb-24">
      <section
        aria-labelledby="map-title"
        class="mx-auto grid max-w-6xl grid-cols-12 gap-x-6 px-4 pt-12 sm:px-8 sm:pt-20"
      >
        <h1 id="map-title" class:list={cn(PAGE_TITLE, "col-span-12")}>
          Mapa umiejętności
        </h1>
        <p class="col-span-12 mt-8 max-w-[44ch] text-lg leading-relaxed sm:text-xl">
          Każdy kwadrat to obszar 2 × 2 km. Kolor pokazuje, ile mieszka w nim osób gotowych pomóc.
        </p>
        <p class="text-ash col-span-12 mt-3 max-w-[52ch] leading-relaxed">
          Mapa nie pokazuje osób, adresów ani dokładnych liczb. Pokazuje tylko przedziały i tylko tam, gdzie mieszka co
          najmniej 5 osób, a po wybraniu kategorii co najmniej 10. Przedziały są celowo lekko zaszumione. Mapa odświeża
          się raz dziennie i uwzględnia konta założone co najmniej 14 dni temu.
        </p>
      </section>

      {loadError && (
        <p role="alert" class="text-alarm mx-auto mt-10 max-w-6xl px-4 sm:px-8">
          {loadError}
        </p>
      )}

      {categories && (
        <DensityMap client:only="react" categories={categories} start={start}>
          <p slot="fallback" class="text-ash mx-auto mt-10 max-w-6xl px-4 sm:px-8">
            Ładowanie mapy…
          </p>
        </DensityMap>
      )}
    </main>
  </div>
</Layout>
