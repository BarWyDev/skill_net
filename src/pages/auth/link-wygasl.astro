---
import AuthShell from "@/components/auth/AuthShell.astro";
import { ServerError } from "@/components/auth/ServerError";
import { cn } from "@/lib/utils";
import { BUTTON, TEXT_LINK } from "@/lib/site-styles";
import { takeFlashError } from "@/lib/flash";

Astro.response.headers.set("Cache-Control", "private, no-store");

// Left by the endpoint that redirected here; never read from the URL (security audit F-06).
const error = takeFlashError(Astro);
---

<AuthShell title="Link wygasł — SkillNet" heading="Link jest nieważny">
  <p class="text-lg leading-relaxed sm:text-xl">
    Link potwierdzający wygasł, został już użyty albo jest niepełny. Podaj adres e-mail, a wyślemy nowy.
  </p>

  <form method="POST" action="/api/auth/resend" class="mt-10 space-y-6">
    <div>
      <label for="email" class="mb-2 block font-bold">
        E-mail
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="ty@przyklad.pl"
        class="field h-12 w-full px-3 text-lg"
      />
    </div>
    <div class="space-y-4 pt-2">
      <ServerError message={error} />
      <button type="submit" class:list={cn(BUTTON, "btn-primary w-full cursor-pointer sm:w-auto")}>
        Wyślij nowy link
      </button>
    </div>
  </form>

  <p class="text-ash mt-10">
    Konto jest już potwierdzone?{" "}
    <a href="/auth/signin" class:list={TEXT_LINK}>
      Zaloguj się
    </a>
  </p>
</AuthShell>
