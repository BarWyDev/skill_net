---
import AuthShell from "@/components/auth/AuthShell.astro";
import { cn } from "@/lib/utils";
import { BUTTON, TEXT_LINK } from "@/lib/site-styles";

const isAutoConfirmed = import.meta.env.DEV;
// After a resend. The copy is the same for every address, so it never says whether one is registered.
const isResend = Astro.url.searchParams.has("ponownie");
// With confirmations off, sign-up returns a session: the new resident is already signed in (QA-016).
const signedIn = Astro.locals.user !== null;

// `primary`: the link is the next step, so it gets the CTA style; otherwise it is a way back.
const content = isResend
  ? {
      heading: "Sprawdź skrzynkę e-mail",
      description:
        "Jeśli konto z tym adresem czeka na potwierdzenie, wysłaliśmy na nie nowy link. Wiadomość może dotrzeć po kilku minutach. Sprawdź też folder ze spamem.",
      linkText: "Wróć do logowania",
      primary: false,
    }
  : signedIn
    ? {
        heading: "Konto założone",
        description:
          "Twoje konto jest gotowe. Możesz od razu uzupełnić profil: dodaj umiejętności i przybliżoną lokalizację, żeby koordynator mógł Cię znaleźć.",
        linkText: "Uzupełnij profil",
        href: "/profil",
        primary: true,
      }
    : isAutoConfirmed
      ? {
          heading: "Konto założone",
          description: "Twoje konto jest gotowe. Możesz się teraz zalogować.",
          linkText: "Przejdź do logowania",
          primary: true,
        }
      : {
          heading: "Sprawdź skrzynkę e-mail",
          description:
            "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto. Jeśli wiadomość nie dotarła, sprawdź folder ze spamem.",
          linkText: "Wróć do logowania",
          primary: false,
        };
---

<AuthShell title={`${content.heading} — SkillNet`} heading={content.heading}>
  <p class="text-lg leading-relaxed sm:text-xl">{content.description}</p>
  <a
    href={"href" in content ? content.href : "/auth/signin"}
    class:list={cn("mt-8", content.primary ? cn(BUTTON, "btn-primary") : TEXT_LINK)}
  >
    {content.linkText}
  </a>
</AuthShell>
