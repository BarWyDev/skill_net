---
import AuthShell from "@/components/auth/AuthShell.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import Turnstile from "@/components/auth/Turnstile.astro";
import { TEXT_LINK } from "@/lib/site-styles";
import { takeFlashError } from "@/lib/flash";
import { auth } from "@/lib/i18n/messages/auth";

// Left by the endpoint that redirected here; never read from the URL (security audit F-06).
const error = takeFlashError(Astro);
const { locale } = Astro.locals;
const t = auth[locale].signUp;
---

<AuthShell title={t.title} description={t.description} heading={t.heading}>
  <SignUpForm locale={locale} serverError={error} client:load>
    <Turnstile slot="captcha" />
  </SignUpForm>
  <p class="text-ash mt-10">
    {t.haveAccount}{" "}
    <a href="/auth/signin" class:list={TEXT_LINK}>
      {t.signInLink}
    </a>
  </p>
  <p slot="aside">{t.aside}</p>
</AuthShell>
