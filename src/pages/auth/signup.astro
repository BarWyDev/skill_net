---
import AuthShell from "@/components/auth/AuthShell.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { TEXT_LINK } from "@/lib/site-styles";
import { takeFlashError } from "@/lib/flash";

// Left by the endpoint that redirected here; never read from the URL (security audit F-06).
const error = takeFlashError(Astro);
---

<AuthShell title="Załóż konto — SkillNet" heading="Załóż konto">
  <SignUpForm serverError={error} client:load />
  <p class="text-ash mt-10">
    Masz już konto?{" "}
    <a href="/auth/signin" class:list={TEXT_LINK}>
      Zaloguj się
    </a>
  </p>
  <p slot="aside">
    Z kontem dodasz swoje umiejętności i przybliżoną lokalizację, żeby koordynator gminy mógł Cię znaleźć. Swoje dane
    zmienisz albo usuniesz w profilu.
  </p>
</AuthShell>
