---
// Where the auth throttle sends a visitor over a limit (security audit F-09, src/lib/auth-throttle.ts).
import AuthShell from "@/components/auth/AuthShell.astro";
import { TEXT_LINK } from "@/lib/site-styles";
import { errors } from "@/lib/i18n/messages/errors";

Astro.response.status = 429;
Astro.response.headers.set("Retry-After", "60");
Astro.response.headers.set("Cache-Control", "private, no-store");
const t = errors[Astro.locals.locale].tooManyAttempts;
---

<AuthShell title={t.title} heading={t.heading}>
  <p class="text-lg leading-relaxed sm:text-xl">{t.body}</p>
  <p class="text-ash mt-10">
    <a href="/auth/signin" class:list={TEXT_LINK}>
      {t.backToSignIn}
    </a>
  </p>
</AuthShell>
