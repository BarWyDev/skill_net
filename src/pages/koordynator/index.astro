---
import PageShell from "@/components/PageShell.astro";
import StatusLine from "@/components/StatusLine.astro";
import StatusMark from "@/components/StatusMark.astro";
import CrisisActivationForm from "@/components/crisis/CrisisActivationForm";
import { createClient } from "@/lib/supabase";
import { getCrisisScenarios, getCrisisTypes, listActiveCrises, listRecentEndedCrises } from "@/lib/services/crisis";
import { formatActivatedAt, formatActiveFor, formatPeople, isStale } from "@/lib/crisis-format";
import type { CrisisDTO, CrisisScenarioDTO, CrisisTypeDTO } from "@/types";
import { BUTTON, SECTION_TITLE } from "@/lib/site-styles";
import { cn } from "@/lib/utils";
import { takeFlashError } from "@/lib/flash";

// The middleware gates this route: only coordinators get here.

// Left by the endpoint that redirected here; never read from the URL (security audit F-06).
const error = takeFlashError(Astro);
const ended = Astro.url.searchParams.get("ended") === "1";
const now = new Date();

let crisisTypes: CrisisTypeDTO[] | null = null;
let activeCrises: CrisisDTO[] | null = null;
let endedCrises: CrisisDTO[] | null = null;
let scenarios: CrisisScenarioDTO[] = [];
let loadError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = "Supabase nie jest skonfigurowany.";
} else {
  try {
    [crisisTypes, activeCrises, endedCrises, scenarios] = await Promise.all([
      getCrisisTypes(supabase),
      listActiveCrises(supabase),
      listRecentEndedCrises(supabase),
      // Exercises are optional: a failure hides the section, never the panel.
      getCrisisScenarios(supabase).catch(() => []),
    ]);
  } catch {
    loadError = "Nie udało się wczytać panelu. Odśwież stronę.";
  }
}

// One row per crisis: the type and its status first, then the area, the activation time and the count.
const ROW =
  "group grid gap-x-6 gap-y-1 border-t border-seam py-4 md:grid-cols-[minmax(0,1fr)_11.5rem_16.5rem_6rem] md:items-baseline";
const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1);
const area = (c: CrisisDTO) => `${c.radiusKm} km${c.epicentrePostcode ? `, okolice ${c.epicentrePostcode}` : ""}`;
---

<PageShell title="Panel koordynatora — SkillNet" heading="Panel koordynatora" wide>
  {ended && (
    <StatusLine tone="done" role="status" class="mb-10 text-lg font-bold">
      Kryzys zakończony. Lista dopasowanych osób została usunięta.
    </StatusLine>
  )}
  {error && (
    <StatusLine tone="error" role="alert" class="mb-10">
      <p class="font-bold">Kryzysu nie aktywowano.</p>
      <p>{error}</p>
    </StatusLine>
  )}
  {loadError && (
    <StatusLine tone="error" role="alert" class="mb-10 font-bold">
      {loadError}
    </StatusLine>
  )}

  {activeCrises && (
    <section aria-labelledby="active-heading">
      <h2 id="active-heading" class:list={SECTION_TITLE}>
        Aktywne kryzysy
      </h2>
      {activeCrises.length === 0 ? (
        <p class="text-ash mt-4 text-lg">Brak aktywnych kryzysów.</p>
      ) : (
        <ul class="border-seam mt-6 border-b">
          {activeCrises.map((c) => {
            const stale = isStale(c.activatedAt, now);
            return (
              <li>
                <a href={`/koordynator/kryzys/${c.id}`} class:list={ROW}>
                  <span class="min-w-0">
                    <span class="block text-xl font-bold underline-offset-4 group-hover:underline">
                      {c.typeName}
                      {c.isExercise && <span class="text-signal font-normal"> · ćwiczenie</span>}
                    </span>
                    <span class="mt-1 block text-[0.9375rem]">
                      {stale ? (
                        <StatusMark tone="attention" class="font-bold">
                          {sentence(formatActiveFor(c.activatedAt, now))}. Sprawdź, czy nadal trwa.
                        </StatusMark>
                      ) : (
                        <StatusMark tone="done">{sentence(formatActiveFor(c.activatedAt, now))}</StatusMark>
                      )}
                    </span>
                  </span>
                  <span class="tabular-nums">{area(c)}</span>
                  <span class="text-ash tabular-nums">{`aktywowano ${formatActivatedAt(c.activatedAt)}`}</span>
                  <span class="font-bold tabular-nums md:text-right">{formatPeople(c.matchCount)}</span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  )}

  {crisisTypes && (
    <section aria-labelledby="activate-heading" class="mt-16 max-w-[42rem] sm:mt-20">
      <h2 id="activate-heading" class:list={SECTION_TITLE}>
        Aktywuj kryzys
      </h2>
      <p class="text-ash mt-3 leading-relaxed">
        Wybierz rodzaj, wskaż epicentrum i promień. Po aktywacji dostaniesz listę mieszkańców z okolicy.
      </p>
      <CrisisActivationForm client:only="react" crisisTypes={crisisTypes}>
        <p slot="fallback" class="text-ash mt-8">
          Ładowanie formularza…
        </p>
      </CrisisActivationForm>
    </section>
  )}

  {crisisTypes && scenarios.length > 0 && (
    <section aria-labelledby="exercises-heading" class="mt-16 sm:mt-20">
      <h2 id="exercises-heading" class:list={SECTION_TITLE}>
        Ćwiczenia
      </h2>
      <p class="text-ash mt-3 max-w-[64ch] leading-relaxed">
        Gotowe scenariusze do treningu i pokazów. Ćwiczenie działa jak kryzys, na prawdziwej liście mieszkańców, ale
        nikt nie dostaje alertu, a numerów telefonów nie można ujawnić. Uruchamia się od razu i liczy do limitu 3
        aktywacji na godzinę.
      </p>
      <ul class="border-seam mt-6 border-b">
        {scenarios.map((s) => (
          <li class="border-seam grid gap-x-6 gap-y-3 border-t py-4 md:grid-cols-[minmax(0,1fr)_16.5rem_auto] md:items-center">
            <span class="min-w-0">
              <span class="block text-xl font-bold">{s.name}</span>
              <span class="text-ash mt-1 block text-[0.9375rem]">{s.typeName}</span>
            </span>
            <span class="tabular-nums">{`${s.radiusKm} km, okolice ${s.postcode}`}</span>
            <form method="POST" action="/api/koordynator/cwiczenia" data-once>
              <input type="hidden" name="scenario" value={s.slug} />
              <button type="submit" class:list={cn(BUTTON, "btn-secondary w-full cursor-pointer md:w-auto")}>
                Uruchom ćwiczenie<span class="sr-only">: {s.name}</span>
              </button>
            </form>
          </li>
        ))}
      </ul>
    </section>
  )}

  {endedCrises && endedCrises.length > 0 && (
    <section aria-labelledby="ended-heading" class="mt-16 sm:mt-20">
      <h2 id="ended-heading" class:list={SECTION_TITLE}>
        Zakończone
      </h2>
      <ul class="border-seam mt-6 border-b">
        {endedCrises.map((c) => (
          <li>
            <a href={`/koordynator/kryzys/${c.id}`} class:list={ROW}>
              <span class="min-w-0">
                <span class="block text-xl font-bold underline-offset-4 group-hover:underline">
                  {c.typeName}
                  {c.isExercise && <span class="text-ash font-normal"> · ćwiczenie</span>}
                </span>
                <span class="mt-1 block text-[0.9375rem]">
                  <StatusMark tone="neutral">
                    {c.endedAt ? `Zakończony ${formatActivatedAt(c.endedAt)}` : "Zakończony"}
                  </StatusMark>
                </span>
              </span>
              <span class="text-ash tabular-nums">{area(c)}</span>
              <span class="text-ash tabular-nums">{`aktywowano ${formatActivatedAt(c.activatedAt)}`}</span>
              <span class="text-ash tabular-nums md:text-right">{formatPeople(c.matchCount)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</PageShell>

<script>
  // One start per click: a second submit would start a second exercise.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-once]")) {
    form.addEventListener("submit", (e) => {
      if (form.dataset.sent) {
        e.preventDefault();
        return;
      }
      form.dataset.sent = "1";
      form.querySelector("button")?.setAttribute("aria-disabled", "true");
    });
  }
</script>
