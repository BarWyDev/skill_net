---
import PageShell from "@/components/PageShell.astro";
import StatusLine from "@/components/StatusLine.astro";
import CrisisFacts from "@/components/crisis/CrisisFacts.astro";
import EndCrisisDialog from "@/components/crisis/EndCrisisDialog.astro";
import PersonStatus from "@/components/crisis/PersonStatus.astro";
import SkillList from "@/components/crisis/SkillList.astro";
import CrisisCoverage from "@/components/crisis/CrisisCoverage.astro";
import { createClient } from "@/lib/supabase";
import { getCrisis, getCrisisCoverage, getCrisisMatches, MATCHES_PAGE_SIZE } from "@/lib/services/crisis";
import { formatDistanceKm, formatPeople } from "@/lib/crisis-format";
import { format } from "@/lib/i18n/format";
import { auth } from "@/lib/i18n/messages/auth";
import { crisis as crisisMessages } from "@/lib/i18n/messages/crisis";
import { BUTTON, SECTION_TITLE } from "@/lib/site-styles";
import { cn } from "@/lib/utils";
import type { CrisisCoverageDTO, CrisisDTO, CrisisMatchDTO } from "@/types";
import { takeFlashError } from "@/lib/flash";

const { locale } = Astro.locals;
const t = crisisMessages[locale].crisisPage;

// The middleware gates this route (coordinators only) and sends Cache-Control: private, no-store.
// The list is a snapshot from activation: no identity, coordinates or score reach this page.
// Availability and phone presence are read live and are display-only: they never change the order.
// No phone number reaches this page, only whether one exists. Numbers are shown only on the
// break-glass page (kontakty), in the response to a logged reveal.
// Ending a crisis deletes the snapshot, so an ended crisis shows only its summary.

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const id = Astro.params.id ?? "";
// Left by the endpoint that redirected here; never read from the URL (security audit F-06).
const error = takeFlashError(Astro);

let crisis: CrisisDTO | null = null;
let matches: CrisisMatchDTO[] = [];
// Null when it failed to load: the list matters more, so a coverage error only hides the section.
let coverage: CrisisCoverageDTO[] | null = null;
let loadError: string | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = auth[locale].notConfigured;
} else if (UUID_RE.test(id)) {
  try {
    crisis = await getCrisis(supabase, id, locale);
    if (crisis?.status === "active") {
      [matches, coverage] = await Promise.all([
        getCrisisMatches(supabase, id, locale),
        getCrisisCoverage(supabase, id, locale).catch(() => null),
      ]);
    }
  } catch {
    loadError = t.loadFailed;
  }
}

if (!crisis && !loadError) Astro.response.status = 404;
const hidden = crisis?.status === "active" ? Math.max(0, crisis.matchCount - matches.length) : 0;
const panel = { href: "/koordynator", label: crisisMessages[locale].panel.heading };
const kind = crisis?.isExercise ? t.kindExercise : t.kindCrisis;
---

<PageShell
  title={crisis ? format(t.title, { kind, type: crisis.typeName }) : t.notFoundTitle}
  heading={crisis?.typeName ?? (loadError ? t.kindCrisis : t.notFound)}
  crumbs={[panel]}
  wide
>
  {loadError && (
    <StatusLine tone="error" role="alert" class="font-bold">
      {loadError}
    </StatusLine>
  )}

  {!crisis && !loadError && <p class="max-w-[52ch] text-lg leading-relaxed">{t.notFoundText}</p>}

  {crisis?.status === "ended" && (
    <>
      <CrisisFacts crisis={crisis} />
      <p class="text-ash mt-8 max-w-[64ch] leading-relaxed">{t.endedListGone}</p>
    </>
  )}

  {crisis?.status === "active" && (
    <>
      {error && (
        <StatusLine tone="error" role="alert" class="mb-8 font-bold">
          {error}
        </StatusLine>
      )}

      <CrisisFacts crisis={crisis} />

      <!-- Destructive, so it stands alone under the facts, in the alarm outline, and asks first. -->
      <div class="mt-8">
        <EndCrisisDialog crisis={crisis} />
      </div>

      <p class="text-ash mt-14 max-w-[64ch] leading-relaxed">{t.listNote}</p>

      <ul class="mt-8 space-y-6">
        <li class="grid gap-x-8 gap-y-3 md:grid-cols-[16rem_minmax(0,1fr)] md:items-center">
          <a
            href={`/koordynator/kryzys/${crisis.id}/zespoly`}
            class:list={cn(BUTTON, "btn-secondary w-full md:w-auto")}
          >
            {t.assembleTeams}
          </a>
          <p class="max-w-[52ch] leading-relaxed">{t.assembleTeamsHelp}</p>
        </li>
        {!crisis.isExercise && (
          <li class="grid gap-x-8 gap-y-3 md:grid-cols-[16rem_minmax(0,1fr)] md:items-center">
            <a
              href={`/koordynator/kryzys/${crisis.id}/kontakty`}
              class:list={cn(BUTTON, "btn-secondary w-full md:w-auto")}
            >
              {t.revealContacts}
            </a>
            <p class="max-w-[52ch] leading-relaxed">{t.revealContactsHelp}</p>
          </li>
        )}
      </ul>

      {coverage && coverage.length > 0 && <CrisisCoverage coverage={coverage} class="mt-16 sm:mt-20" />}

      <section aria-labelledby="matches-heading" class="mt-16 sm:mt-20">
        <h2 id="matches-heading" class:list={SECTION_TITLE}>
          {t.matchesHeading}
        </h2>

        {matches.length === 0 ? (
          <p class="mt-4 max-w-[64ch] text-lg leading-relaxed">{t.noMatches}</p>
        ) : (
          <>
            <p class="text-ash mt-3 max-w-[64ch] leading-relaxed">{t.matchesIntro}</p>
            <ol class="border-seam mt-6 border-b">
              {matches.map((m) => (
                <li class="border-seam grid grid-cols-[2.75rem_minmax(0,1fr)_auto] gap-x-4 gap-y-2 border-t py-5 md:grid-cols-[4rem_minmax(0,1fr)_6rem_17rem] md:grid-rows-[auto_1fr] md:gap-x-6">
                  <p class="font-display row-span-3 text-right text-[2.25rem] leading-[0.85] tabular-nums md:row-span-2 md:text-[2.75rem]">
                    <span class="sr-only">{t.rank} </span>
                    {m.rank}
                  </p>
                  <p class="text-lg leading-tight font-bold">{format(t.person, { position: m.position })}</p>
                  <p class="text-right text-lg leading-tight tabular-nums md:text-left">
                    {formatDistanceKm(locale, m.distanceKm)}
                    <span class="sr-only"> {t.fromEpicentre}</span>
                  </p>
                  <SkillList skills={m.skills} class="col-span-2 col-start-2 md:col-span-1" />
                  <PersonStatus
                    availableNow={m.availableNow}
                    availabilitySlots={m.availabilitySlots}
                    hasPhone={m.hasPhone}
                    class="col-span-2 col-start-2 md:col-span-1 md:col-start-4 md:row-span-2 md:row-start-1"
                  />
                </li>
              ))}
            </ol>
          </>
        )}

        {hidden > 0 && (
          <p class="text-ash mt-6 leading-relaxed">
            {format(t.moreHidden, { count: MATCHES_PAGE_SIZE, people: formatPeople(locale, hidden) })}
          </p>
        )}
      </section>
    </>
  )}
</PageShell>
