---
import { CircleAlert } from "lucide-react";
import PageShell from "@/components/PageShell.astro";
import StatusLine from "@/components/StatusLine.astro";
import StatusMark from "@/components/StatusMark.astro";
import CrisisFacts from "@/components/crisis/CrisisFacts.astro";
import PersonStatus from "@/components/crisis/PersonStatus.astro";
import SkillList from "@/components/crisis/SkillList.astro";
import { formatDistanceKm } from "@/lib/crisis-format";
import { BUTTON, SECTION_TITLE } from "@/lib/site-styles";
import { createClient } from "@/lib/supabase";
import { assembleCrisisTeams, getCrisis, getTeamTemplates } from "@/lib/services/crisis";
import { parseTeamRequest, TEAM_COUNT_MAX, TEAM_COUNT_MIN } from "@/lib/validation/crisis";
import { cn } from "@/lib/utils";
import type { CrisisDTO, CrisisTeamDTO, TeamTemplateDTO } from "@/types";

// Crisis team templates (S-10, FR-014). A GET form: the template and the team count live in the
// query string, so a reload gives the same teams (the solver is deterministic). Teams are computed
// per request from the crisis's snapshot and the residents' current skills, and never stored.
// Declared availability is shown but never changes who is chosen. The middleware gates this route
// (coordinators only) and sends Cache-Control: private, no-store. No identity reaches this page.

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const id = Astro.params.id ?? "";
const params = Astro.url.searchParams;
const submitted = params.has("szablon") || params.has("liczba");

let crisis: CrisisDTO | null = null;
let templates: TeamTemplateDTO[] = [];
let template: TeamTemplateDTO | null = null;
let requested = 0;
let teams: CrisisTeamDTO[] | null = null;
let completeCount = 0;
let loadError: string | null = null;
let formError: string | null = null;
let ended = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = "Supabase nie jest skonfigurowany.";
} else if (UUID_RE.test(id)) {
  try {
    crisis = await getCrisis(supabase, id);
    if (crisis?.status === "active") templates = await getTeamTemplates(supabase);
  } catch {
    loadError = "Nie udało się wczytać kryzysu. Odśwież stronę.";
  }
}

if (!crisis && !loadError) Astro.response.status = 404;
if (crisis?.status === "ended") ended = true;

if (supabase && crisis?.status === "active" && !loadError && submitted) {
  const parsed = parseTeamRequest(params);
  template = parsed.success ? (templates.find((t) => t.slug === parsed.data.template) ?? null) : null;

  if (!parsed.success) {
    formError = parsed.message;
    Astro.response.status = 422;
  } else if (!template) {
    formError = "Wybierz szablon zespołu z listy.";
    Astro.response.status = 422;
  } else {
    requested = parsed.data.count;
    try {
      const result = await assembleCrisisTeams(supabase, crisis.id, template, requested);
      if (result.ok) {
        teams = result.teams;
        completeCount = result.completeCount;
      } else if (result.ended) {
        ended = true;
      } else {
        formError = result.message;
        Astro.response.status = result.status;
      }
    } catch {
      formError = "Nie udało się złożyć zespołów. Spróbuj ponownie.";
      Astro.response.status = 500;
    }
  }
}

const selectedSlug = template?.slug ?? params.get("szablon") ?? templates.at(0)?.slug ?? "";
// Echo what was typed, so an invalid count stays visible next to its message.
const selectedCount = params.get("liczba") ?? "1";
const formatRoles = (t: TeamTemplateDTO) =>
  t.roles.map((r) => (r.slots > 1 ? `${r.slots} × ${r.name}` : r.name)).join(" + ");
const missingRoles = (team: CrisisTeamDTO) => [
  ...new Set(team.slots.filter((slot) => !slot.member).map((slot) => slot.roleName)),
];
// Teams the list cannot fill at all are not returned, so say so instead of leaving them out (QA-027).
const partialCount = teams?.filter((team) => !team.complete).length ?? 0;
const unassembled = teams ? Math.max(0, requested - teams.length) : 0;
const firstUnassembled = requested - unassembled + 1;
const shortRoles = teams?.flatMap((team) => (team.complete ? [] : missingRoles(team))) ?? [];
const crumbs = [
  { href: "/koordynator", label: "Panel koordynatora" },
  ...(crisis ? [{ href: `/koordynator/kryzys/${crisis.id}`, label: crisis.typeName }] : []),
];
const heading = !crisis ? (loadError ? "Zespoły" : "Nie znaleziono kryzysu") : ended ? crisis.typeName : "Złóż zespoły";
---

<PageShell
  title={crisis ? `Zespoły: ${crisis.typeName}` : "Nie znaleziono kryzysu"}
  heading={heading}
  crumbs={crumbs}
  crumbLabel={crisis ? "Zespoły" : undefined}
  wide
>
  {loadError && (
    <StatusLine tone="error" role="alert" class="font-bold">
      {loadError}
    </StatusLine>
  )}

  {!crisis && !loadError && (
    <p class="max-w-[52ch] text-lg leading-relaxed">Ten kryzys nie istnieje albo nie masz do niego dostępu.</p>
  )}

  {crisis && ended && (
    <StatusLine tone="neutral" role="alert" class="max-w-[64ch] text-lg">
      Ten kryzys został zakończony. Lista osób została usunięta, więc nie można złożyć zespołów.
    </StatusLine>
  )}

  {crisis && !ended && !loadError && (
    <>
      <CrisisFacts crisis={crisis} showType />

      <form method="get" class="border-seam mt-12 max-w-[42rem] border-t pt-10">
        <fieldset>
          <legend class:list={cn(SECTION_TITLE, "mb-4")}>Szablon zespołu</legend>
          <div class="space-y-1">
            {templates.map((t) => (
              <label
                for={`szablon-${t.slug}`}
                aria-label={`${t.name}: ${formatRoles(t)}`}
                class="flex min-h-11 cursor-pointer items-start gap-4 py-2"
              >
                <input
                  id={`szablon-${t.slug}`}
                  type="radio"
                  name="szablon"
                  value={t.slug}
                  checked={t.slug === selectedSlug}
                  required
                  class="radio mt-0.5"
                />
                <span>
                  <span class="block text-lg font-bold">{t.name}</span>
                  <span class="text-ash block leading-relaxed">{formatRoles(t)}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-8">
          <label for="liczba" class="mb-2 block font-bold">
            Liczba zespołów
          </label>
          <input
            id="liczba"
            type="number"
            name="liczba"
            min={TEAM_COUNT_MIN}
            max={TEAM_COUNT_MAX}
            step="1"
            value={selectedCount}
            required
            aria-invalid={formError ? "true" : undefined}
            aria-describedby={formError ? "teams-error" : "teams-hint"}
            class="field block h-12 w-28 px-3 text-lg tabular-nums"
          />
          {formError ? (
            <p id="teams-error" role="alert" class="text-alarm mt-2 flex gap-2 text-[0.9375rem]">
              <CircleAlert aria-hidden="true" className="mt-[0.2em] size-4 shrink-0" />
              {formError}
            </p>
          ) : (
            <p id="teams-hint" class="text-ash mt-2 text-[0.9375rem]">
              Od {TEAM_COUNT_MIN} do {TEAM_COUNT_MAX}.
            </p>
          )}
        </div>

        <button type="submit" class:list={cn(BUTTON, "btn-primary mt-8 w-full cursor-pointer sm:w-auto")}>
          Złóż zespoły
        </button>
      </form>

      {teams && template && (
        <section aria-labelledby="teams-heading" class="border-seam mt-16 border-t pt-10">
          <h2 id="teams-heading" class:list={SECTION_TITLE}>
            {template.name}
          </h2>
          <p class="mt-4 text-lg">
            Pełne zespoły: <strong>{completeCount}</strong> z {requested}
            {partialCount > 0 && <>, niepełne: {partialCount}</>}
            {unassembled > 0 && <>, niezłożone: {unassembled}</>}
          </p>
          <p class="text-ash mt-3 max-w-[64ch] leading-relaxed">
            Zespoły składamy z listy dopasowanych do tego kryzysu, według aktualnych umiejętności mieszkańców: najpierw
            jak najwięcej pełnych zespołów, potem osoby wyżej na liście. Deklarowana dostępność nie wpływa na wybór.
          </p>

          {teams.length === 0 ? (
            <p class="mt-8 text-lg">Nikt z listy dopasowanych nie pasuje do tego szablonu.</p>
          ) : (
            <ol class="mt-10 space-y-12">
              {teams.map((team) => (
                <li>
                  <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
                    <h3 id={`team-${team.number}`} class="font-display text-[1.75rem] leading-none">
                      Zespół {team.number}
                    </h3>
                    {team.complete ? (
                      <StatusMark tone="done">pełny</StatusMark>
                    ) : (
                      <StatusMark tone="attention" class="font-bold">
                        niepełny, brakuje: {missingRoles(team).join(", ")}
                      </StatusMark>
                    )}
                  </div>
                  <ul class="border-seam mt-4 border-b">
                    {team.slots.map((slot) => (
                      <li class="border-seam grid gap-x-6 gap-y-2 border-t py-4 md:grid-cols-[11rem_minmax(0,1fr)_6rem_17rem]">
                        <p class="font-bold">{slot.roleName}</p>
                        {slot.member ? (
                          <>
                            <div class="min-w-0">
                              <p class="font-bold">
                                Osoba #{slot.member.position}
                                <span class="text-ash font-normal">, miejsce {slot.member.rank}.</span>
                              </p>
                              <SkillList skills={slot.member.skills} class="mt-1" />
                            </div>
                            <p class="tabular-nums">
                              {formatDistanceKm(slot.member.distanceKm)}
                              <span class="sr-only"> od epicentrum</span>
                            </p>
                            <PersonStatus
                              availableNow={slot.member.availableNow}
                              availabilitySlots={slot.member.availabilitySlots}
                              hasPhone={slot.member.hasPhone}
                            />
                          </>
                        ) : (
                          <p class="md:col-span-3">
                            <StatusMark tone="attention">brak osoby</StatusMark>
                          </p>
                        )}
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          )}
          {teams.length > 0 && unassembled > 0 && (
            <StatusLine tone="attention" class="mt-10 max-w-[64ch]">
              {unassembled === 1
                ? `Zespołu ${requested} nie da się złożyć`
                : `Zespołów ${firstUnassembled}–${requested} nie da się złożyć`}
              {shortRoles.length > 0
                ? `: na liście dopasowanych brakuje osób z rolą ${shortRoles.join(", ")}.`
                : ": na liście dopasowanych brakuje osób do tego szablonu."}
            </StatusLine>
          )}
        </section>
      )}
    </>
  )}
</PageShell>
