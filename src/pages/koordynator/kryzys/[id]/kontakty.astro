---
import PageShell from "@/components/PageShell.astro";
import { FieldError } from "@/components/auth/FieldError";
import StatusLine from "@/components/StatusLine.astro";
import StatusMark from "@/components/StatusMark.astro";
import CrisisFacts from "@/components/crisis/CrisisFacts.astro";
import PersonStatus from "@/components/crisis/PersonStatus.astro";
import SkillList from "@/components/crisis/SkillList.astro";
import { formatActivatedAt, formatDistanceKm, formatPeople } from "@/lib/crisis-format";
import { BUTTON, NAV_LINK } from "@/lib/site-styles";
import { format } from "@/lib/i18n/format";
import { auth } from "@/lib/i18n/messages/auth";
import { crisis as crisisMessages } from "@/lib/i18n/messages/crisis";
import { formatPhone } from "@/lib/phone";
import { createClient } from "@/lib/supabase";
import { getCrisis, revealCrisisContacts } from "@/lib/services/crisis";
import { parseRevealReason, REASON_MAX, REASON_MIN } from "@/lib/validation/crisis";
import { cn } from "@/lib/utils";
import { declinedVerb, revealCounts } from "@/lib/visibility";
import type { CrisisContactDTO, CrisisDTO } from "@/types";

const { locale } = Astro.locals;
const t = crisisMessages[locale].contacts;
const cp = crisisMessages[locale].crisisPage;

// Break-glass (S-09, FR-012). GET shows the warning and the reason form, never a number. POST calls
// reveal_crisis_contacts, which logs the reveal, and renders the numbers in this response only:
// no redirect, nothing in a URL, cookie or client storage. A reload or a resubmitted form is a new,
// separately logged reveal. The middleware gates this route (coordinators only) and sends
// Cache-Control: private, no-store; do not override it. Never log the reason or a number.
// An exercise never reveals: the page says so and does not call the RPC, which refuses it anyway.

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const id = Astro.params.id ?? "";

let crisis: CrisisDTO | null = null;
let contacts: CrisisContactDTO[] | null = null;
let revealedAt: string | null = null;
let loadError: string | null = null;
let formError: string | null = null;
let closedMessage: string | null = null;
let reason = "";

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = auth[locale].notConfigured;
} else if (UUID_RE.test(id)) {
  try {
    crisis = await getCrisis(supabase, id, locale);
  } catch {
    loadError = t.loadFailed;
  }
}

if (!crisis && !loadError) Astro.response.status = 404;

if (supabase && crisis?.status === "active" && !crisis.isExercise && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const raw = form.get("reason");
  reason = typeof raw === "string" ? raw : "";
  const parsed = parseRevealReason(form, locale);

  if (!parsed.success) {
    formError = parsed.message;
    Astro.response.status = 422;
  } else {
    try {
      const result = await revealCrisisContacts(supabase, crisis.id, parsed.data, locale);
      if (result.ok) {
        contacts = result.contacts;
        revealedAt = new Date().toISOString();
      } else if (result.ended) {
        closedMessage = result.message;
      } else {
        formError = result.message;
        Astro.response.status = result.status;
      }
    } catch {
      formError = t.failed;
      Astro.response.status = 500;
    }
  }
}

if (crisis?.status === "ended") {
  closedMessage = t.ended;
} else if (crisis?.isExercise) {
  closedMessage = t.exercise_no_reveal;
}

// Declined (V4) is a count only, never who. The list's "ma telefon" marker and the revealed positions
// together still give the declined positions (pseudonymous; see the change notes).
const counts = crisis && contacts ? revealCounts(crisis.matchCount, contacts.length, crisis.revealDeclinedCount) : null;
const anyUnverified = contacts?.some((c) => !c.phoneVerified) ?? false;
const crumbs = [
  { href: "/koordynator", label: crisisMessages[locale].panel.heading },
  ...(crisis ? [{ href: `/koordynator/kryzys/${crisis.id}`, label: crisis.typeName }] : []),
];
const heading = !crisis
  ? loadError
    ? t.crumb
    : cp.notFound
  : closedMessage
    ? crisis.typeName
    : contacts
      ? t.headingRevealed
      : cp.revealContacts;
---

<PageShell
  title={crisis ? format(t.title, { type: crisis.typeName }) : cp.notFoundTitle}
  heading={heading}
  crumbs={crumbs}
  crumbLabel={crisis ? t.crumb : undefined}
  wide
>
  {loadError && (
    <StatusLine tone="error" role="alert" class="font-bold">
      {loadError}
    </StatusLine>
  )}

  {!crisis && !loadError && <p class="max-w-[52ch] text-lg leading-relaxed">{cp.notFoundText}</p>}

  {crisis && closedMessage && (
    <StatusLine tone="neutral" role="alert" class="max-w-[64ch] text-lg">
      {closedMessage}
    </StatusLine>
  )}

  {crisis && !closedMessage && !contacts && (
    <>
      <CrisisFacts crisis={crisis} showType />

      <!-- Serious, not loud: plain statements, and the alarm tone only on the action that reveals. -->
      <div class="border-seam mt-12 max-w-[42rem] space-y-4 border-t pt-10 leading-relaxed">
        <p class="text-lg">
          {t.warningBefore} <strong>{t.warningAll}</strong> {t.warningAfter}
        </p>
        <p>{t.logged}</p>
        {crisis.revealDeclinedCount > 0 && (
          <p>
            {format(t.declined, {
              people: formatPeople(locale, crisis.revealDeclinedCount),
              verb: declinedVerb(locale, crisis.revealDeclinedCount),
            })}
          </p>
        )}
        <p class="text-ash">{t.vanish}</p>
      </div>

      <form method="post" class="mt-10 max-w-[42rem]">
        <label for="reason" class="mb-2 block font-bold">
          {t.reasonLabel}
        </label>
        <textarea
          id="reason"
          name="reason"
          required
          minlength={REASON_MIN}
          maxlength={REASON_MAX}
          rows="3"
          autocomplete="off"
          aria-invalid={formError ? "true" : undefined}
          aria-describedby={formError ? "reason-error" : "reason-hint"}
          class="field block w-full resize-y px-3 py-3 text-lg leading-relaxed"
          placeholder={t.reasonPlaceholder}
        >{reason}</textarea>
        {formError ? (
          <FieldError id="reason-error" role="alert">
            {formError}
          </FieldError>
        ) : (
          <p id="reason-hint" class="text-ash mt-2 text-[0.9375rem]">
            {format(t.reasonHint, { min: REASON_MIN, max: REASON_MAX })}
          </p>
        )}
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <button type="submit" class:list={cn(BUTTON, "btn-danger w-full cursor-pointer sm:w-auto")}>
            {cp.revealContacts}
          </button>
          <a href={`/koordynator/kryzys/${crisis.id}`} class:list={NAV_LINK}>
            {crisisMessages[locale].end.cancel}
          </a>
        </div>
      </form>
    </>
  )}

  {crisis && contacts && revealedAt && (
    <>
      <StatusLine tone="done" role="status" class="max-w-[64ch] text-lg">
        <p class="font-bold">{format(t.revealed, { time: formatActivatedAt(locale, revealedAt) })}</p>
        <p class="text-ash text-base">{format(t.revealedFacts, { type: crisis.typeName, radius: crisis.radiusKm })}</p>
      </StatusLine>

      {anyUnverified && (
        <StatusLine tone="attention" class="mt-6 max-w-[64ch] font-bold">
          {t.unverified}
        </StatusLine>
      )}

      {contacts.length === 0 ? (
        <p class="mt-10 text-lg">{counts && counts.declined > 0 ? t.noneAvailable : t.noneGiven}</p>
      ) : (
        <ol class="border-seam mt-10 border-b">
          {contacts.map((c) => (
            <li class="border-seam grid grid-cols-[2.75rem_minmax(0,1fr)] gap-x-4 gap-y-2 border-t py-5 md:grid-cols-[4rem_minmax(0,1fr)_13rem_17rem] md:grid-rows-[auto_1fr] md:gap-x-6">
              <p class="font-display row-span-4 text-right text-[2.25rem] leading-[0.85] tabular-nums md:row-span-2 md:text-[2.75rem]">
                <span class="sr-only">{cp.rank} </span>
                {c.rank}
              </p>
              <p class="text-lg leading-tight">
                <span class="font-bold">{format(cp.person, { position: c.position })}</span>
                <span class="text-ash tabular-nums">
                  , {formatDistanceKm(locale, c.distanceKm)}
                  <span class="sr-only"> {cp.fromEpicentre}</span>
                </span>
              </p>
              <div class="md:col-start-3 md:row-span-2 md:row-start-1">
                <a
                  href={`tel:${c.phone}`}
                  class="inline-flex min-h-12 items-center text-2xl font-bold tabular-nums underline decoration-2 underline-offset-6 hover:decoration-signal"
                >
                  <span class="sr-only">{t.call} </span>
                  {formatPhone(c.phone)}
                </a>
                {anyUnverified && c.phoneVerified && (
                  <p class="text-[0.9375rem]">
                    <StatusMark tone="done">{t.verified}</StatusMark>
                  </p>
                )}
              </div>
              <SkillList skills={c.skills} class="md:col-start-2 md:row-start-2" />
              <PersonStatus
                availableNow={c.availableNow}
                availabilitySlots={c.availabilitySlots}
                class="md:col-start-4 md:row-span-2 md:row-start-1"
              />
            </li>
          ))}
        </ol>
      )}

      <p class="text-ash mt-6 leading-relaxed">
        {/* Explicit spaces: the whitespace between two expressions is dropped. */}
        {format(t.withoutPhone, { people: formatPeople(locale, counts?.withoutPhone ?? 0) })}{" "}
        {counts && counts.declined > 0 && (
          <>{format(t.withoutConsent, { people: formatPeople(locale, counts.declined) })} </>
        )}
        {t.numbersGone}
      </p>
    </>
  )}
</PageShell>
