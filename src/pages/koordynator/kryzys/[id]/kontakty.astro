---
import { CircleAlert } from "lucide-react";
import PageShell from "@/components/PageShell.astro";
import StatusLine from "@/components/StatusLine.astro";
import StatusMark from "@/components/StatusMark.astro";
import CrisisFacts from "@/components/crisis/CrisisFacts.astro";
import PersonStatus from "@/components/crisis/PersonStatus.astro";
import SkillList from "@/components/crisis/SkillList.astro";
import { formatActivatedAt, formatDistanceKm, formatPeople } from "@/lib/crisis-format";
import { BUTTON, NAV_LINK } from "@/lib/site-styles";
import { formatPhone } from "@/lib/phone";
import { createClient } from "@/lib/supabase";
import { getCrisis, revealCrisisContacts } from "@/lib/services/crisis";
import { parseRevealReason, REASON_MAX, REASON_MIN } from "@/lib/validation/crisis";
import { cn } from "@/lib/utils";
import type { CrisisContactDTO, CrisisDTO } from "@/types";

// Break-glass (S-09, FR-012). GET shows the warning and the reason form, never a number. POST calls
// reveal_crisis_contacts, which logs the reveal, and renders the numbers in this response only:
// no redirect, nothing in a URL, cookie or client storage. A reload or a resubmitted form is a new,
// separately logged reveal. The middleware gates this route (coordinators only) and sends
// Cache-Control: private, no-store; do not override it. Never log the reason or a number.

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const id = Astro.params.id ?? "";

let crisis: CrisisDTO | null = null;
let contacts: CrisisContactDTO[] | null = null;
let revealedAt: string | null = null;
let loadError: string | null = null;
let formError: string | null = null;
let endedMessage: string | null = null;
let reason = "";

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  loadError = "Supabase nie jest skonfigurowany.";
} else if (UUID_RE.test(id)) {
  try {
    crisis = await getCrisis(supabase, id);
  } catch {
    loadError = "Nie udało się wczytać kryzysu. Odśwież stronę.";
  }
}

if (!crisis && !loadError) Astro.response.status = 404;

if (supabase && crisis?.status === "active" && Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const raw = form.get("reason");
  reason = typeof raw === "string" ? raw : "";
  const parsed = parseRevealReason(form);

  if (!parsed.success) {
    formError = parsed.message;
    Astro.response.status = 422;
  } else {
    try {
      const result = await revealCrisisContacts(supabase, crisis.id, parsed.data);
      if (result.ok) {
        contacts = result.contacts;
        revealedAt = new Date().toISOString();
      } else if (result.ended) {
        endedMessage = result.message;
      } else {
        formError = result.message;
        Astro.response.status = result.status;
      }
    } catch {
      formError = "Nie udało się ujawnić kontaktów. Spróbuj ponownie.";
      Astro.response.status = 500;
    }
  }
}

if (crisis?.status === "ended") {
  endedMessage = "Ten kryzys został zakończony — kontaktów nie można ujawnić.";
}

const withoutPhone = crisis && contacts ? Math.max(0, crisis.matchCount - contacts.length) : 0;
const anyUnverified = contacts?.some((c) => !c.phoneVerified) ?? false;
const crumbs = [
  { href: "/koordynator", label: "Panel koordynatora" },
  ...(crisis ? [{ href: `/koordynator/kryzys/${crisis.id}`, label: crisis.typeName }] : []),
];
const heading = !crisis
  ? loadError
    ? "Kontakty"
    : "Nie znaleziono kryzysu"
  : endedMessage
    ? crisis.typeName
    : contacts
      ? "Kontakty ujawnione"
      : "Ujawnij kontakty";
---

<PageShell
  title={crisis ? `Kontakty: ${crisis.typeName}` : "Nie znaleziono kryzysu"}
  heading={heading}
  crumbs={crumbs}
  crumbLabel={crisis ? "Kontakty" : undefined}
  wide
>
  {loadError && (
    <StatusLine tone="error" role="alert" class="font-bold">
      {loadError}
    </StatusLine>
  )}

  {!crisis && !loadError && (
    <p class="max-w-[52ch] text-lg leading-relaxed">Ten kryzys nie istnieje albo nie masz do niego dostępu.</p>
  )}

  {crisis && endedMessage && (
    <StatusLine tone="neutral" role="alert" class="max-w-[64ch] text-lg">
      {endedMessage}
    </StatusLine>
  )}

  {crisis && !endedMessage && !contacts && (
    <>
      <CrisisFacts crisis={crisis} showType />

      <!-- Serious, not loud: plain statements, and the alarm tone only on the action that reveals. -->
      <div class="border-seam mt-12 max-w-[42rem] space-y-4 border-t pt-10 leading-relaxed">
        <p class="text-lg">
          Zobaczysz numery telefonów <strong>wszystkich</strong> dopasowanych osób, które podały numer. Używaj tego
          tylko wtedy, gdy nie da się ich zawiadomić inaczej.
        </p>
        <p>Ujawnienie zostanie trwale zapisane: Twoje konto, czas, powód i lista osób, których numery zobaczysz.</p>
        <p class="text-ash">
          Numery znikną po opuszczeniu strony. Każde ponowne wyświetlenie to nowe, osobno zapisane ujawnienie.
        </p>
      </div>

      <form method="post" class="mt-10 max-w-[42rem]">
        <label for="reason" class="mb-2 block font-bold">
          Powód ujawnienia
        </label>
        <textarea
          id="reason"
          name="reason"
          required
          minlength={REASON_MIN}
          maxlength={REASON_MAX}
          rows="3"
          autocomplete="off"
          aria-invalid={formError ? "true" : undefined}
          aria-describedby={formError ? "reason-error" : "reason-hint"}
          class="field block w-full resize-y px-3 py-3 text-lg leading-relaxed"
          placeholder="np. brak potwierdzeń od 30 minut, awaria sieci komórkowej"
        >{reason}</textarea>
        {formError ? (
          <p id="reason-error" role="alert" class="text-alarm mt-2 flex gap-2 text-[0.9375rem]">
            <CircleAlert aria-hidden="true" className="mt-[0.2em] size-4 shrink-0" />
            {formError}
          </p>
        ) : (
          <p id="reason-hint" class="text-ash mt-2 text-[0.9375rem]">
            Od {REASON_MIN} do {REASON_MAX} znaków.
          </p>
        )}
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <button type="submit" class:list={cn(BUTTON, "btn-danger w-full cursor-pointer sm:w-auto")}>
            Ujawnij kontakty
          </button>
          <a href={`/koordynator/kryzys/${crisis.id}`} class:list={NAV_LINK}>
            Anuluj
          </a>
        </div>
      </form>
    </>
  )}

  {crisis && contacts && revealedAt && (
    <>
      <StatusLine tone="done" role="status" class="max-w-[64ch] text-lg">
        <p class="font-bold">Ujawnienie zapisano w dzienniku, {formatActivatedAt(revealedAt)}.</p>
        <p class="text-ash text-base">
          {crisis.typeName}, promień {crisis.radiusKm} km. Numery znikną po opuszczeniu tej strony.
        </p>
      </StatusLine>

      {anyUnverified && (
        <StatusLine tone="attention" class="mt-6 max-w-[64ch] font-bold">
          Numery nie są zweryfikowane i mogą być błędne.
        </StatusLine>
      )}

      {contacts.length === 0 ? (
        <p class="mt-10 text-lg">Żadna z dopasowanych osób nie podała numeru telefonu.</p>
      ) : (
        <ol class="border-seam mt-10 border-b">
          {contacts.map((c) => (
            <li class="border-seam grid grid-cols-[2.75rem_minmax(0,1fr)] gap-x-4 gap-y-2 border-t py-5 md:grid-cols-[4rem_minmax(0,1fr)_13rem_17rem] md:grid-rows-[auto_1fr] md:gap-x-6">
              <p class="font-display row-span-4 text-right text-[2.25rem] leading-[0.85] tabular-nums md:row-span-2 md:text-[2.75rem]">
                <span class="sr-only">Miejsce </span>
                {c.rank}
              </p>
              <p class="text-lg leading-tight">
                <span class="font-bold">Osoba #{c.position}</span>
                <span class="text-ash tabular-nums">
                  , {formatDistanceKm(c.distanceKm)}
                  <span class="sr-only"> od epicentrum</span>
                </span>
              </p>
              <div class="md:col-start-3 md:row-span-2 md:row-start-1">
                <a
                  href={`tel:${c.phone}`}
                  class="inline-flex min-h-12 items-center text-2xl font-bold tabular-nums underline decoration-2 underline-offset-6 hover:decoration-signal"
                >
                  <span class="sr-only">Zadzwoń: </span>
                  {formatPhone(c.phone)}
                </a>
                {anyUnverified && c.phoneVerified && (
                  <p class="text-[0.9375rem]">
                    <StatusMark tone="done">zweryfikowany</StatusMark>
                  </p>
                )}
              </div>
              <SkillList skills={c.skills} class="md:col-start-2 md:row-start-2" />
              <PersonStatus
                availableNow={c.availableNow}
                availabilitySlots={c.availabilitySlots}
                class="md:col-start-4 md:row-span-2 md:row-start-1"
              />
            </li>
          ))}
        </ol>
      )}

      <p class="text-ash mt-6 leading-relaxed">
        Bez numeru telefonu: {formatPeople(withoutPhone)}. Numery znikną po opuszczeniu tej strony.
      </p>
    </>
  )}
</PageShell>
