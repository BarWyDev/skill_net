---
// The facts under a crisis heading: its status in words (with the grid-motif marker), an exercise
// notice, then radius, area, times and the number of matched people as a definition list.
import StatusMark from "@/components/StatusMark.astro";
import { formatActivatedAt, formatActiveFor, formatPeople, isStale } from "@/lib/crisis-format";
import { format } from "@/lib/i18n/format";
import { crisis as crisisMessages } from "@/lib/i18n/messages/crisis";
import type { CrisisDTO } from "@/types";

interface Props {
  crisis: CrisisDTO;
  /** Repeat the crisis type when the page heading names something else (teams, contacts). */
  showType?: boolean;
}

const { crisis, showType = false } = Astro.props;
const { locale } = Astro.locals;
const t = crisisMessages[locale].facts;
const words = crisisMessages[locale].format;
const now = new Date();
const stale = crisis.status === "active" && isStale(crisis.activatedAt, now);
const activeFor = formatActiveFor(locale, crisis.activatedAt, now);
---

<p class="text-lg font-bold">
  {crisis.status === "ended" ? (
    <StatusMark tone="neutral">{t.ended}</StatusMark>
  ) : stale ? (
    <StatusMark tone="attention">{format(t.stale, { activeFor })}</StatusMark>
  ) : (
    <StatusMark tone="done">{format(t.active, { activeFor })}</StatusMark>
  )}
</p>

{crisis.isExercise && (
  <p class="mt-2 max-w-[64ch] leading-relaxed">
    <StatusMark tone="attention" class="font-bold">
      {t.exercise}
    </StatusMark>
    <span class="text-ash"> {t.exerciseNote}</span>
  </p>
)}

<dl class="mt-6 flex flex-wrap gap-x-10 gap-y-4">
  {showType && (
    <div>
      <dt class="text-ash text-[0.9375rem]">{t.type}</dt>
      <dd class="text-lg font-bold">{crisis.typeName}</dd>
    </div>
  )}
  <div>
    <dt class="text-ash text-[0.9375rem]">{t.radius}</dt>
    <dd class="text-lg font-bold tabular-nums">{format(words.km, { km: crisis.radiusKm })}</dd>
  </div>
  {crisis.epicentrePostcode && (
    <div>
      <dt class="text-ash text-[0.9375rem]">{t.area}</dt>
      <dd class="text-lg font-bold tabular-nums">{format(words.place, { postcode: crisis.epicentrePostcode })}</dd>
    </div>
  )}
  <div>
    <dt class="text-ash text-[0.9375rem]">{t.activatedAt}</dt>
    <dd class="text-lg font-bold tabular-nums">{formatActivatedAt(locale, crisis.activatedAt)}</dd>
  </div>
  {crisis.endedAt && (
    <div>
      <dt class="text-ash text-[0.9375rem]">{t.endedAt}</dt>
      <dd class="text-lg font-bold tabular-nums">{formatActivatedAt(locale, crisis.endedAt)}</dd>
    </div>
  )}
  <div>
    <dt class="text-ash text-[0.9375rem]">{t.matched}</dt>
    <dd class="text-lg font-bold tabular-nums">{formatPeople(locale, crisis.matchCount)}</dd>
  </div>
</dl>
