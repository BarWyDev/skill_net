---
import { formatPeople } from "@/lib/crisis-format";
import type { CrisisDTO } from "@/types";

// "Zakończ kryzys" with a native confirmation dialog. With JS the button opens the dialog;
// without JS it submits the same form directly. "Anuluj" closes the dialog natively.

interface Props {
  crisis: CrisisDTO;
}

const { crisis } = Astro.props;
const formId = "end-crisis-form";
---

<button
  type="submit"
  form={formId}
  data-end-crisis-open
  class="rounded-lg border border-red-400/60 bg-red-600/30 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-red-600/50"
>
  Zakończ kryzys
</button>

<dialog
  data-end-crisis-dialog
  aria-labelledby="end-crisis-title"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-white/15 bg-slate-900 p-0 text-white backdrop:bg-black/60"
>
  <form id={formId} method="post" action={`/api/koordynator/kryzysy/${crisis.id}/zakoncz`} class="p-4 sm:p-6">
    <h2 id="end-crisis-title" class="mb-3 text-lg font-semibold">
      Zakończyć kryzys?
    </h2>
    <p class="mb-3 text-sm text-blue-100/80">
      {crisis.typeName} · promień {crisis.radiusKm} km · {formatPeople(crisis.matchCount)} dopasowanych
    </p>
    <p class="mb-5 rounded-lg border border-red-400/50 bg-red-500/15 p-3 text-sm text-red-100">
      Lista dopasowanych osób zostanie trwale usunięta. Tej operacji nie można cofnąć.
    </p>
    <div class="flex flex-wrap justify-end gap-2">
      <button
        type="submit"
        formmethod="dialog"
        class="rounded-lg border border-white/20 px-4 py-2 text-sm text-blue-100 hover:bg-white/10"
      >
        Anuluj
      </button>
      <button
        type="submit"
        class="rounded-lg border border-red-400/60 bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-500"
      >
        Zakończ kryzys
      </button>
    </div>
  </form>
</dialog>

<script>
  const opener = document.querySelector<HTMLButtonElement>("[data-end-crisis-open]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-end-crisis-dialog]");
  if (opener && dialog && typeof dialog.showModal === "function") {
    opener.addEventListener("click", (event) => {
      event.preventDefault();
      dialog.showModal();
    });
  }
</script>
