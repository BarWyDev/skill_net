---
import { formatCrisisTitle, formatPeople, matchedWord } from "@/lib/crisis-format";
import { BUTTON } from "@/lib/site-styles";
import { cn } from "@/lib/utils";
import type { CrisisDTO } from "@/types";

// "Zakończ kryzys" with a native confirmation dialog. With JS the button opens the dialog;
// without JS it submits the same form directly. "Anuluj" closes the dialog natively, and so does Esc.
// showModal() makes the rest of the page inert, so focus stays in the dialog; it starts on "Anuluj",
// the safe choice, and goes back to the opener on close.

interface Props {
  crisis: CrisisDTO;
}

const { crisis } = Astro.props;
const formId = "end-crisis-form";
---

<button
  type="submit"
  form={formId}
  data-end-crisis-open
  class:list={cn(BUTTON, "btn-danger w-full cursor-pointer sm:w-auto")}
>
  Zakończ kryzys
</button>

<dialog
  data-end-crisis-dialog
  aria-labelledby="end-crisis-title"
  aria-describedby="end-crisis-consequence"
  class="end-crisis-dialog bg-graphite text-chalk border-seam m-auto w-[calc(100%-2rem)] max-w-lg border p-0"
>
  <form id={formId} method="post" action={`/api/koordynator/kryzysy/${crisis.id}/zakoncz`} class="p-6 sm:p-8">
    <h2 id="end-crisis-title" class="font-display text-[2rem] leading-none">
      Zakończyć kryzys?
    </h2>
    <p class="text-ash mt-4 leading-relaxed">
      {`${formatCrisisTitle(crisis)}, ${formatPeople(crisis.matchCount)} ${matchedWord(crisis.matchCount)}`}
    </p>
    <p id="end-crisis-consequence" class="mt-3 leading-relaxed font-bold">
      Lista dopasowanych osób zostanie trwale usunięta. Tej operacji nie można cofnąć.
    </p>
    <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <button
        type="submit"
        formmethod="dialog"
        data-end-crisis-cancel
        class:list={cn(BUTTON, "btn-secondary cursor-pointer")}
      >
        Anuluj
      </button>
      <button type="submit" class:list={cn(BUTTON, "btn-danger cursor-pointer")}>
        Zakończ kryzys
      </button>
    </div>
  </form>
</dialog>

<style>
  .end-crisis-dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
  }
  /* The one motion on the page: the dialog fades in when it opens. */
  @media (prefers-reduced-motion: no-preference) {
    .end-crisis-dialog {
      transition: opacity 150ms ease-out;
      @starting-style {
        opacity: 0;
      }
    }
  }
</style>

<script>
  const opener = document.querySelector<HTMLButtonElement>("[data-end-crisis-open]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-end-crisis-dialog]");
  if (opener && dialog && typeof dialog.showModal === "function") {
    opener.addEventListener("click", (event) => {
      event.preventDefault();
      dialog.showModal();
      // Start on the safe choice, so Enter or Space never ends the crisis by accident.
      dialog.querySelector<HTMLButtonElement>("[data-end-crisis-cancel]")?.focus();
    });
    dialog.addEventListener("close", () => {
      opener.focus();
    });
  }
</script>
