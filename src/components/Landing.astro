---
import { cn } from "@/lib/utils";

const { user, isCoordinator } = Astro.locals;

// The headline is split by meaning, and each line rises separately on load.
const HEADLINE = [
  { text: "Lokalny katalog", accent: false },
  { text: "umiejętności", accent: false },
  { text: "na czas kryzysu", accent: true },
];

const POINTS = [
  {
    title: "Dodaj swoje umiejętności",
    body: "Ratownictwo, elektryka, języki, sprzęt. Zaznacz, w czym możesz pomóc i kiedy masz na to czas.",
  },
  {
    title: "Twoja lokalizacja jest chroniona",
    body: "Zapisujemy tylko przybliżony obszar, około 500 m. Publiczna mapa pokazuje dla kwadratów 2 km wyłącznie przedziały liczby osób.",
  },
  {
    title: "Pomoc, gdy jest potrzebna",
    body: "W kryzysie koordynator gminy znajduje najbliższe osoby z potrzebnymi umiejętnościami i prosi je o pomoc.",
  },
];

// At least 44 px tall, so every link and button is easy to tap on a phone (QA-001).
const NAV_LINK = "inline-flex min-h-11 items-center text-ash underline-offset-4 hover:text-chalk hover:underline";
const BUTTON = "inline-flex min-h-12 items-center justify-center px-6 font-bold";
---

<div class="landing min-h-screen">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-3">
      <p class="font-display text-[1.75rem] leading-none">SkillNet</p>
      <nav aria-label="Główna" class="flex flex-wrap items-center gap-x-5 text-[0.9375rem]">
        {user ? (
          <>
            <span class="text-ash max-w-full truncate">{user.email}</span>
            {isCoordinator && (
              <a href="/koordynator" class:list={NAV_LINK}>
                Koordynator
              </a>
            )}
            <a href="/mapa" class:list={NAV_LINK}>
              Mapa
            </a>
            <a href="/profil" class:list={NAV_LINK}>
              Mój profil
            </a>
            <form method="POST" action="/api/auth/signout">
              <button type="submit" class:list={cn(NAV_LINK, "cursor-pointer")}>
                Wyloguj
              </button>
            </form>
          </>
        ) : (
          <>
            <a href="/mapa" class:list={NAV_LINK}>
              Mapa
            </a>
            <a href="/auth/signin" class:list={NAV_LINK}>
              Zaloguj się
            </a>
            <a href="/auth/signup" class:list={NAV_LINK}>
              Załóż konto
            </a>
          </>
        )}
      </nav>
    </header>

    <main>
      <!-- Page notices, e.g. the account-erasure confirmation -->
      <slot />

      <section aria-labelledby="landing-title" class="grid grid-cols-12 gap-x-6 pt-14 pb-20 sm:pt-24 lg:pt-28 lg:pb-28">
        <h1 id="landing-title" class="headline font-display col-span-12">
          {HEADLINE.map((line, i) => (
            <span class="line">
              <span class:list={cn(line.accent && "text-signal")} style={`--i:${i}`}>
                {line.text}
              </span>
            </span>
          ))}
        </h1>
        <p class="col-span-12 mt-10 max-w-[38ch] text-lg leading-relaxed sm:mt-12 sm:text-xl md:col-span-8 lg:col-span-6">
          Gdy brakuje prądu, wody albo rąk do pracy, koordynator gminy szybko znajduje sąsiadów, którzy mogą pomóc. Na
          co dzień ci sami ludzie pomagają sobie w okolicy.
        </p>
        <div class="col-span-12 mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href="/mapa" class:list={cn(BUTTON, "btn-primary")}>
            Zobacz mapę umiejętności
          </a>
          {user ? (
            <a href="/profil" class:list={cn(BUTTON, "btn-secondary")}>
              Mój profil
            </a>
          ) : (
            <>
              <a href="/auth/signup" class:list={cn(BUTTON, "btn-secondary")}>
                Załóż konto
              </a>
              <a href="/auth/signin" class:list={cn(NAV_LINK, "text-chalk font-bold underline")}>
                Zaloguj się
              </a>
            </>
          )}
        </div>
      </section>

      <section aria-labelledby="landing-how" class="pt-4 pb-20 sm:pt-8 lg:pb-28">
        <h2 id="landing-how" class="sr-only">
          Jak to działa
        </h2>
        {POINTS.map((point) => (
          <div class="grid grid-cols-12 gap-x-6 gap-y-2 py-6 sm:py-8">
            <h3 class="font-display col-span-12 text-[2rem] leading-none md:col-span-5 lg:col-span-4">{point.title}</h3>
            <p class="text-ash col-span-12 max-w-[52ch] leading-relaxed md:col-span-7 lg:col-span-6 lg:col-start-6">
              {point.body}
            </p>
          </div>
        ))}
      </section>
    </main>
  </div>
</div>

<style>
  /* Landing-only tokens: graphite and chalk with one hi-vis accent. Other pages keep their theme. */
  .landing {
    --graphite: #1e2024;
    --chalk: #ece9e2;
    --ash: #a3a6ad;
    --seam: #3a3d44;
    --signal: #f2c230;

    background: var(--graphite);
    color: var(--chalk);
    font-family: "Atkinson Hyperlegible Next", ui-sans-serif, sans-serif;
    font-size: 1.0625rem;
  }

  .landing :global(.font-display) {
    font-family: "Big Shoulders Display", ui-sans-serif, sans-serif;
    font-weight: 800;
  }
  .landing :global(.text-chalk),
  .landing :global(.hover\:text-chalk:hover) {
    color: var(--chalk);
  }
  .landing :global(.text-ash) {
    color: var(--ash);
  }
  .landing :global(.text-signal) {
    color: var(--signal);
  }
  .landing :global(.notice) {
    border: 1px solid var(--seam);
  }

  .landing :global(a:focus-visible),
  .landing :global(button:focus-visible) {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
  }

  .headline {
    font-size: clamp(2.5rem, 14.5vw, 10rem);
    line-height: 0.86;
    letter-spacing: -0.01em;
  }
  /* Each line is a mask; the padding keeps Polish accents and descenders inside it. */
  .line {
    display: block;
    overflow: clip;
    padding-block: 0.12em 0.24em;
    margin-block: -0.12em -0.24em;
  }
  .line > span {
    display: inline-block;
  }

  .btn-primary {
    background: var(--signal);
    color: var(--graphite);
  }
  .btn-primary:hover {
    background: #f7d564;
  }
  .btn-secondary {
    box-shadow: inset 0 0 0 2px var(--chalk);
  }
  .btn-secondary:hover {
    background: var(--seam);
  }

  /* The one orchestrated moment: the headline rises line by line. */
  @media (prefers-reduced-motion: no-preference) {
    .line > span {
      animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i) * 110ms + 80ms);
    }
  }

  @keyframes rise {
    from {
      transform: translateY(140%);
    }
  }

  /* Overscroll (rubber-band) reveals the document behind the page; paint it graphite too. */
  :global(html:has(.landing)),
  :global(html:has(.landing) body) {
    background: #1e2024;
    color-scheme: dark;
  }
</style>
