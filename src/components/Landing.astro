---
import SiteHeader from "@/components/SiteHeader.astro";
import { cn } from "@/lib/utils";
import { BUTTON, TEXT_LINK } from "@/lib/site-styles";

const { user } = Astro.locals;

// The headline is split by meaning, and each line rises separately on load.
const HEADLINE = [
  { text: "Lokalny katalog", accent: false },
  { text: "umiejętności", accent: false },
  { text: "na czas kryzysu", accent: true },
];

const POINTS = [
  {
    title: "Dodaj swoje umiejętności",
    body: "Ratownictwo, elektryka, języki, sprzęt. Zaznacz, w czym możesz pomóc i kiedy masz na to czas.",
  },
  {
    title: "Twoja lokalizacja jest chroniona",
    body: "Zapisujemy tylko przybliżony obszar, około 500 m. Publiczna mapa pokazuje dla kwadratów 2 km wyłącznie przedziały liczby osób.",
  },
  {
    title: "Pomoc, gdy jest potrzebna",
    body: "W kryzysie koordynator gminy znajduje najbliższe osoby z potrzebnymi umiejętnościami i prosi je o pomoc.",
  },
];
---

<div class="site landing min-h-screen">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <SiteHeader />

    <main>
      <!-- Page notices, e.g. the account-erasure confirmation -->
      <slot />

      <section aria-labelledby="landing-title" class="grid grid-cols-12 gap-x-6 pt-14 pb-20 sm:pt-24 lg:pt-28 lg:pb-28">
        <h1 id="landing-title" class="headline font-display col-span-12">
          {HEADLINE.map((line, i) => (
            <span class="line">
              <span class:list={cn(line.accent && "text-signal")} style={`--i:${i}`}>
                {line.text}
              </span>
            </span>
          ))}
        </h1>
        <p class="col-span-12 mt-10 max-w-[38ch] text-lg leading-relaxed sm:mt-12 sm:text-xl md:col-span-8 lg:col-span-6">
          Gdy brakuje prądu, wody albo rąk do pracy, koordynator gminy szybko znajduje sąsiadów, którzy mogą pomóc. Na
          co dzień ci sami ludzie pomagają sobie w okolicy.
        </p>
        <div class="col-span-12 mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href="/mapa" class:list={cn(BUTTON, "btn-primary")}>
            Zobacz mapę umiejętności
          </a>
          {user ? (
            <a href="/profil" class:list={cn(BUTTON, "btn-secondary")}>
              Mój profil
            </a>
          ) : (
            <>
              <a href="/auth/signup" class:list={cn(BUTTON, "btn-secondary")}>
                Załóż konto
              </a>
              <a href="/auth/signin" class:list={TEXT_LINK}>
                Zaloguj się
              </a>
            </>
          )}
        </div>
      </section>

      <section aria-labelledby="landing-how" class="pt-4 pb-20 sm:pt-8 lg:pb-28">
        <h2 id="landing-how" class="sr-only">
          Jak to działa
        </h2>
        {POINTS.map((point) => (
          <div class="grid grid-cols-12 gap-x-6 gap-y-2 py-6 sm:py-8">
            <h3 class="font-display col-span-12 text-[2rem] leading-none md:col-span-5 lg:col-span-4">{point.title}</h3>
            <p class="text-ash col-span-12 max-w-[52ch] leading-relaxed md:col-span-7 lg:col-span-6 lg:col-start-6">
              {point.body}
            </p>
          </div>
        ))}
      </section>
    </main>
  </div>
</div>

<style>
  .headline {
    font-size: clamp(2.5rem, 14.5vw, 10rem);
    line-height: 0.86;
    letter-spacing: -0.01em;
  }
  /* Each line is a mask; the padding keeps Polish accents and descenders inside it. */
  .line {
    display: block;
    overflow: clip;
    padding-block: 0.12em 0.24em;
    margin-block: -0.12em -0.24em;
  }
  .line > span {
    display: inline-block;
  }

  /* The one orchestrated moment: the headline rises line by line. */
  @media (prefers-reduced-motion: no-preference) {
    .line > span {
      animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(var(--i) * 110ms + 80ms);
    }
  }

  @keyframes rise {
    from {
      transform: translateY(140%);
    }
  }
</style>
