---
// "Usuń konto": a plain form POST, so it works without JS. Errors come back through the `?error=` alert
// at the top of the page named by `returnTo` (/profil or /zgoda).
import { BUTTON, SECTION_TITLE } from "@/lib/site-styles";
import { cn } from "@/lib/utils";

interface Props {
  returnTo?: "/profil" | "/zgoda";
}

const { returnTo = "/profil" } = Astro.props;
---

<!-- Destructive, so it sits last and furthest from "Zapisz", in the alarm tone: a heading and an
     outline button, never a filled red panel. -->
<section aria-labelledby="delete-account-title" class="border-seam mt-24 border-t pt-10 sm:mt-32">
  <h2 id="delete-account-title" class:list={cn(SECTION_TITLE, "text-alarm")}>
    Usuń konto
  </h2>
  <p id="delete-account-consequence" class="mt-4 leading-relaxed">
    Twoje konto, profil, umiejętności, numer telefonu i dostępność zostaną usunięte natychmiast. Tej operacji nie można
    cofnąć.
  </p>
  <p class="text-ash mt-3 leading-relaxed">
    Dzienniki audytowe zachowują wyłącznie anonimowy identyfikator, który po usunięciu konta nie wskazuje na żadną
    osobę.
  </p>
  <form method="post" action="/api/auth/unregister" class="mt-6">
    <input type="hidden" name="return_to" value={returnTo} />
    <label for="delete-account-password" class="mb-2 block font-bold">
      Potwierdź hasłem
    </label>
    <input
      id="delete-account-password"
      name="password"
      type="password"
      autocomplete="current-password"
      required
      aria-describedby="delete-account-consequence"
      class="field block h-12 w-full px-3 text-lg sm:max-w-sm"
    />
    <button type="submit" class:list={cn(BUTTON, "btn-danger mt-6 w-full cursor-pointer sm:w-auto")}>
      Usuń konto na zawsze
    </button>
  </form>
</section>
