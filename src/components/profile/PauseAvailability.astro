---
// "Wstrzymaj dostępność": a plain form POST, so it works without JS. The date bounds come from the
// server (Warsaw calendar), never from the browser clock. Errors come back through the `?error=`
// alert at the top of /profil.
import { pauseDateBounds } from "@/lib/pause";
import { BUTTON } from "@/lib/site-styles";
import { cn } from "@/lib/utils";

interface Props {
  paused: boolean;
  /** The last paused day (YYYY-MM-DD), or null for an open-ended pause. */
  pausedUntil: string | null;
}

const { paused, pausedUntil } = Astro.props;
const { min, max } = pauseDateBounds(new Date());
// The form starts from the current pause, so saving it unchanged keeps it (QA-022).
const indefinite = paused && !pausedUntil;
---

<section aria-labelledby="pause-availability-title" class="border-seam mt-16 border-t pt-10">
  <h2 id="pause-availability-title" class="font-display text-[2rem] leading-none">
    {paused ? "Zmień wstrzymanie dostępności" : "Wstrzymaj dostępność"}
  </h2>
  <p id="pause-availability-help" class="text-ash mt-4 leading-relaxed">
    Na czas wstrzymania nie pojawisz się w nowych kryzysach ani na mapie, a w trwających kryzysach koordynator Cię nie
    widzi. Twój profil i konto zostają bez zmian.
  </p>
  <form method="post" action="/api/profile/pause" class="mt-6">
    <fieldset aria-describedby="pause-availability-help">
      <legend class="mb-1 font-bold">Jak długo</legend>
      <label class="flex min-h-11 cursor-pointer items-center gap-4">
        <input type="radio" name="mode" value="date" checked={!indefinite} class="radio" />
        Do dnia (włącznie)
      </label>
      <div class="pb-2 pl-10">
        <label for="pause-until" class="sr-only">
          Ostatni dzień wstrzymania
        </label>
        <input
          id="pause-until"
          name="until"
          type="date"
          min={min}
          max={max}
          value={paused ? (pausedUntil ?? undefined) : undefined}
          class="field block h-12 w-full max-w-60 px-3 text-lg scheme-dark"
        />
      </div>
      <label class="flex min-h-11 cursor-pointer items-center gap-4">
        <input type="radio" name="mode" value="indefinite" checked={indefinite} class="radio" />
        Bezterminowo, do wznowienia
      </label>
    </fieldset>
    <button type="submit" class:list={cn(BUTTON, "btn-secondary mt-6 w-full cursor-pointer sm:w-auto")}>
      {paused ? "Zmień wstrzymanie" : "Wstrzymaj dostępność"}
    </button>
  </form>
</section>
