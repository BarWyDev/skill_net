---
const { user, isCoordinator } = Astro.locals;
// At least 44 px tall, so the links are easy to tap on a phone (QA-001).
const LINK =
  "inline-flex min-h-11 items-center text-purple-300 transition-colors hover:text-purple-100 hover:underline";
---

<div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-xl border border-white/10 bg-white/5 px-4 py-1 text-sm text-white/80">
  {user ? (
    <>
      <span class="min-w-0 truncate text-blue-100/70">{user.email}</span>
      <div class="flex flex-wrap items-center gap-x-4">
        {isCoordinator && (
          <a href="/koordynator" class:list={LINK}>
            Koordynator
          </a>
        )}
        <a href="/mapa" class:list={LINK}>
          Mapa
        </a>
        <a href="/profil" class:list={LINK}>
          Mój profil
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class:list={LINK}>
            Wyloguj
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-blue-100/70">Nie zalogowano</span>
      <div class="flex flex-wrap items-center gap-x-4">
        <a href="/mapa" class:list={LINK}>
          Mapa
        </a>
        <a href="/auth/signin" class:list={LINK}>
          Zaloguj się
        </a>
        <a href="/auth/signup" class:list={LINK}>
          Załóż konto
        </a>
      </div>
    </>
  )}
</div>
