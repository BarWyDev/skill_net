---
const { user } = Astro.locals;
---

<div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm text-white/80">
  {user ? (
    <>
      <span class="min-w-0 truncate text-blue-100/70">{user.email}</span>
      <div class="flex items-center gap-3">
        <a href="/profil" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Mój profil
        </a>
        <a href="/dashboard" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Panel
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Wyloguj
          </button>
        </form>
      </div>
    </>
  ) : (
    <>
      <span class="text-blue-100/70">Nie zalogowano</span>
      <div class="flex gap-3">
        <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Zaloguj się
        </a>
        <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Załóż konto
        </a>
      </div>
    </>
  )}
</div>
