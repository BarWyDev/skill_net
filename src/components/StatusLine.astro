---
// A quiet status statement: a marker from the map-grid motif, then the text. The marker's shape carries
// the meaning, so colour is never the only signal: a filled square is done, an empty square needs
// attention, and an error gets the same icon as the form errors.
import type { HTMLAttributes } from "astro/types";
import { CircleAlert } from "lucide-react";
import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<"div"> {
  tone: "done" | "attention" | "error";
}

const { tone, class: className, ...rest } = Astro.props;
---

<div
  class:list={cn(
    "flex gap-3 leading-relaxed",
    tone === "done" && "text-chalk",
    tone === "attention" && "text-signal",
    tone === "error" && "text-alarm",
    className,
  )}
  {...rest}
>
  {tone === "error" ? (
    <CircleAlert aria-hidden="true" className="mt-[0.3em] size-4 shrink-0" />
  ) : (
    <span
      aria-hidden="true"
      class:list={["mt-[0.4em] size-3.5 shrink-0", tone === "done" ? "bg-signal" : "border-signal border-2"]}
    ></span>
  )}
  <div class="min-w-0">
    <slot />
  </div>
</div>
