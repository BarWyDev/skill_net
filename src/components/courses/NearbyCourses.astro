---
// "W okolicy": open courses in the viewer's 3×3 block, on one small map and in a list. A row never
// shows the organiser, the skill level or the creation date. Plain form POSTs to /api/kursy/*.
import StatusLine from "@/components/StatusLine.astro";
import { CoursesMap } from "@/components/courses/CoursesMap";
import { formatPauseUntil } from "@/lib/pause";
import { INLINE_LINK, SECTION_TITLE } from "@/lib/site-styles";
import { cn } from "@/lib/utils";
import { formatCourseDuration } from "@/lib/validation/courses";
import type { CourseAreaDTO, NearbyCourseDTO } from "@/types";
import type { Polygon } from "geojson";

interface Props {
  courses: NearbyCourseDTO[];
  area: CourseAreaDTO;
}

const { courses, area } = Astro.props;

// One letter per square, in the RPC order (square, then title, then id), so the rows of one square
// sit together and share its letter.
const squares: { letter: string; cell: Polygon }[] = [];
const letters = new Map<string, string>();
for (const course of courses) {
  const key = JSON.stringify(course.cell.coordinates);
  if (!letters.has(key)) {
    const letter = String.fromCharCode(65 + squares.length);
    letters.set(key, letter);
    squares.push({ letter, cell: course.cell });
  }
}
const letterOf = (course: NearbyCourseDTO) => letters.get(JSON.stringify(course.cell.coordinates)) ?? "";

const places = (course: NearbyCourseDTO) =>
  course.placesLeft === null
    ? "Bez limitu miejsc"
    : course.isFull
      ? "Brak miejsc"
      : `Wolne miejsca: ${course.placesLeft}`;

const eligibleOn = area.eligibleOn ? formatPauseUntil(area.eligibleOn) : null;
const SMALL_BUTTON = "inline-flex min-h-11 items-center justify-center px-4 font-bold";
---

<section aria-labelledby="nearby-courses-title">
  <h2 id="nearby-courses-title" class:list={SECTION_TITLE}>
    W okolicy
  </h2>

  {area.eligibility === "ok" && area.block ? (
    <>
      <p class="text-ash mt-4 leading-relaxed">
        Kursy sąsiadów z Twojego kwadratu 2 km i ośmiu kwadratów wokół niego. Nie pokazujemy, kto prowadzi kurs. Miejsce
        i termin poda organizator osobom zapisanym.
      </p>

      <div class="mt-6">
        <CoursesMap client:only="react" block={area.block} squares={squares}>
          <p slot="fallback" class="text-ash">
            Ładowanie mapy…
          </p>
        </CoursesMap>
        <p class="text-ash mt-2 text-[0.9375rem] leading-relaxed">
          Linia przerywana to Twoja okolica. Litera oznacza kwadrat 2 × 2 km, w którym odbywa się kurs.
        </p>
      </div>

      {courses.length === 0 ? (
        <p class="mt-8 leading-relaxed">W Twojej okolicy nie ma teraz żadnych kursów.</p>
      ) : (
        <ul class="mt-8 space-y-8">
          {courses.map((course) => (
            <li>
              <article aria-labelledby={`nearby-${course.id}-title`} class="border-seam border-t pt-6">
                <div class="flex gap-4">
                  <span
                    class="border-signal inline-flex size-9 shrink-0 items-center justify-center border font-bold"
                    title={`Kwadrat ${letterOf(course)} na mapie`}
                  >
                    <span class="sr-only">Kwadrat</span>
                    {letterOf(course)}
                  </span>
                  <div class="min-w-0">
                    <h3 id={`nearby-${course.id}-title`} class="text-xl font-bold break-words">
                      {course.title}
                    </h3>
                    <p class="text-ash mt-1">
                      {course.skillName} ({course.categoryName}) · {formatCourseDuration(course.durationMinutes)}
                    </p>
                  </div>
                </div>

                <p class="mt-4 leading-relaxed break-words">{course.description}</p>
                <p class:list={cn("mt-4", course.isFull && !course.signedUp && "text-ash")}>{places(course)}</p>

                {course.signedUp ? (
                  <div class="mt-4 space-y-4">
                    <StatusLine tone="done">
                      <p>Masz zapis na ten kurs. Szczegóły spotkania są w „Moje zapisy”.</p>
                    </StatusLine>
                    <form method="post" action="/api/kursy/wypisz">
                      <input type="hidden" name="id" value={course.id} />
                      <button type="submit" class:list={cn(SMALL_BUTTON, "btn-secondary cursor-pointer")}>
                        Wypisz się
                      </button>
                    </form>
                  </div>
                ) : (
                  !course.isFull && (
                    <form method="post" action="/api/kursy/zapisz" class="mt-4">
                      <input type="hidden" name="id" value={course.id} />
                      <button type="submit" class:list={cn(SMALL_BUTTON, "btn-primary cursor-pointer")}>
                        Zapisz się
                      </button>
                    </form>
                  )
                )}
              </article>
            </li>
          ))}
        </ul>
      )}
    </>
  ) : (
    <p class="mt-4 leading-relaxed">
      {area.eligibility === "no_location" ? (
        <>
          Aby zobaczyć kursy w okolicy,{" "}
          <a href="/profil" class:list={INLINE_LINK}>
            dodaj lokalizację w profilu
          </a>
          . Kursy zobaczysz 7 dni po jej ustawieniu.
        </>
      ) : area.eligibility === "recent_move" ? (
        <>
          Twoja lokalizacja zmieniła się w ostatnich 7 dniach.{" "}
          {eligibleOn ? `Kursy w okolicy zobaczysz od ${eligibleOn}.` : "Kursy zobaczysz 7 dni po zmianie."}
        </>
      ) : area.eligibility === "too_new" ? (
        <>
          Kursy są dostępne dla kont założonych co najmniej 14 dni temu.{" "}
          {eligibleOn ? `Zobaczysz je od ${eligibleOn}.` : ""}
        </>
      ) : area.eligibility === "unconfirmed" ? (
        "Potwierdź adres e-mail, aby zobaczyć kursy w okolicy."
      ) : (
        <>
          Aby zobaczyć kursy w okolicy,{" "}
          <a href="/zgoda" class:list={INLINE_LINK}>
            zaakceptuj zgodę na przetwarzanie danych
          </a>
          .
        </>
      )}
    </p>
  )}
</section>
