---
// A site-wide notice above the header (missing configuration). Graphite like every page, with the
// status colour only on the bottom edge, so the text keeps the palette's contrast.
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;
---

<div class:list={["banner", `banner--${variant}`]} role={variant === "error" ? "alert" : "status"}>
  <div class="mx-auto max-w-6xl px-4 py-3 sm:px-8">
    <slot />
  </div>
</div>

<style>
  .banner {
    background: var(--color-graphite);
    color: var(--color-chalk);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    border-bottom: 2px solid var(--banner-edge);
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 700;
  }
  .banner :global(a:focus-visible) {
    outline: 3px solid var(--color-signal);
    outline-offset: 3px;
  }
  .banner--info {
    --banner-edge: var(--color-ash);
  }
  .banner--warning {
    --banner-edge: var(--color-signal);
  }
  .banner--error {
    --banner-edge: var(--color-alarm);
  }
</style>
