---
// The shell of every auth page: the landing's header and footer, a display heading and one narrow
// column on the landing's grid. The optional `aside` slot holds one quiet sentence of context.
import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/SiteHeader.astro";

interface Props {
  title: string;
  heading: string;
}

const { title, heading } = Astro.props;
const hasAside = Astro.slots.has("aside");
---

<Layout title={title} footer="graphite">
  <div class="site min-h-screen">
    <div class="mx-auto max-w-6xl px-4 sm:px-8">
      <SiteHeader />

      <main class="grid grid-cols-12 gap-x-6 pt-12 pb-20 sm:pt-20 lg:pb-28">
        <h1 class="font-display col-span-12 text-[clamp(2.75rem,10vw,6.5rem)] leading-[0.9]">{heading}</h1>
        <div class="col-span-12 mt-10 max-w-md sm:mt-12 md:col-span-7 lg:col-span-5">
          <slot />
        </div>
        {hasAside && (
          <div class="text-ash col-span-12 mt-14 max-w-[36ch] leading-relaxed md:col-span-4 md:col-start-9 md:mt-12 lg:col-start-8">
            <slot name="aside" />
          </div>
        )}
      </main>
    </div>
  </div>
</Layout>
