# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# cloudflare
.dev.vars
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler deploy output (WRANGLER_OUTPUT_FILE_PATH)
wrangler-output.json

# raw address data for scripts/build-postcode-centroids.mjs (never committed)
data/

# local QA test-account passwords (skillnet-qa skill)
docs/qa/.konta.local

# staging database connection string for scripts/db-staging.mjs (never committed)
.staging-db-url

# course material (10xDevs skills, prompts and CLI metadata): lives in ~/.claude/skills/, never in
# this repository. scripts/check-no-course-material.sh enforces it in pre-commit and CI.
.claude/skills/10x-*
.agents/skills/10x-*
.claude/prompts/
.claude/.10x-cli-manifest.json
.10x-cli.json
